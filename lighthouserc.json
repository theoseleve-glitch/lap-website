{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": ["http://localhost/index.html", "http://localhost/demo/index.html"],
      "settings": {
        "onlyCategories": ["performance"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost/index\\.html$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 1500 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost/demo/index\\.html$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
