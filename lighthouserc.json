{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/demo/index.html",
        "http://localhost/product/index.html",
        "http://localhost/product/desktop/index.html",
        "http://localhost/product/mobile/index.html",
        "http://localhost/product/bridge/index.html",
        "http://localhost/product/coaching/index.html",
        "http://localhost/product/driver-profile/index.html",
        "http://localhost/blog/index.html",
        "http://localhost/blog/driver-development-plan/index.html",
        "http://localhost/blog/what-is-trail-braking/index.html",
        "http://localhost/blog/why-im-building-lap-not-motec-clone/index.html"
      ],
      "settings": {
        "onlyCategories": ["performance"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost/index\\.html$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 1500 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost/demo/index\\.html$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost/product/(desktop/|mobile/|bridge/|coaching/|driver-profile/)?index\\.html$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost/blog/(?:[^/]+/)?index\\.html$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
