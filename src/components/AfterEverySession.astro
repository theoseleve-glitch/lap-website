---
// Section narrates the three beats of the coaching loop — the product
// principle behind "every lap, one step better". Each tile maps to a
// real backend object in ADR-005: §5.2 WeaknessEpisode, §5.3
// ActionPrescription, §5.4 ActionOutcome. Copy stays deterministic —
// no LLM-generated text, no "AI coach" framing (ADR-004 §4 principle 4).

interface LoopBeat {
  index: string;
  heading: string;
  body: string;
}

const BEATS: LoopBeat[] = [
  {
    index: '01',
    heading: 'Weakness detected',
    body: 'LAP watches your sessions for patterns that recur — late braking into T1 at Spa, early throttle on exit at Silverstone — and groups them by car, track, and conditions so the diagnosis is specific to how you actually drove.',
  },
  {
    index: '02',
    heading: 'Prescription issued',
    body: 'Each open pattern pairs with a concrete drill — a target metric, a target value, and the session count you should execute it across. Not "brake later," but "trail-release to 12% at apex over the next three sessions."',
  },
  {
    index: '03',
    heading: 'Outcome measured',
    body: 'Your next sessions either hit the target or they do not. LAP compares the measured value to your baseline and marks the weakness closed, improving, or still open — every line of the plan is falsifiable.',
  },
];

const HEADING_ID = 'after-every-session-heading';
---

<section
  aria-labelledby={HEADING_ID}
  class="px-grid-margin border-steel/10 mx-auto w-full max-w-6xl border-t py-24 sm:py-32"
>
  <header class="max-w-prose">
    <p class="text-steel text-caption tracking-wide uppercase">The coaching loop</p>
    <h2 id={HEADING_ID} class="font-display text-h2 text-chalk tracking-display mt-4 text-balance">
      After every session.
    </h2>
    <p class="text-steel text-body mt-5">
      One driver profile, three beats, every lap. Observation turns into a prescription; the
      prescription becomes a number you can hit — or miss — on the next session.
    </p>
  </header>

  <ol class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6">
    {
      BEATS.map((beat) => (
        <li class="flex">
          <article class="border-steel/15 bg-concrete/40 rounded-2 flex flex-1 flex-col border p-7">
            <span class="text-steel text-caption font-mono tracking-widest">{beat.index}</span>
            <h3 class="font-display text-h4 text-chalk tracking-display mt-4 text-balance">
              {beat.heading}
            </h3>
            <p class="text-steel text-body leading-body mt-4">{beat.body}</p>
          </article>
        </li>
      ))
    }
  </ol>
</section>
