---
// Visual mock of the webapp's Driver Profile surface, rendered entirely
// in HTML + CSS so it stays sharp at every DPR (per T028 "renders
// crisp"). Shape mirrors ADR-005 §5.1 DriverProgressSnapshot:
// overall_score + per-dimension scores. Numbers are illustrative — the
// aria-label tells screen readers the element is a preview, not state.

interface Dimension {
  name: string;
  score: number;
}

const OVERALL_SCORE = 72;
const TREND_LABEL = '+4 this week';
const SESSION_FOOTER = '12 sessions · last 14 days';

const DIMENSIONS: Dimension[] = [
  { name: 'Braking', score: 78 },
  { name: 'Throttle', score: 65 },
  { name: 'Minimum speed', score: 71 },
  { name: 'Consistency', score: 82 },
];
---

<figure
  class="border-steel/20 bg-concrete rounded-2 shadow-e2 mx-auto w-full max-w-md border p-6 text-left"
  role="img"
  aria-label={`Driver Profile preview — overall ${OVERALL_SCORE} out of 100, improving`}
>
  <figcaption
    class="text-steel text-caption flex items-center justify-between tracking-wide uppercase"
  >
    <span>Driver Profile</span>
    <span class="text-steel/70">Month 1</span>
  </figcaption>

  <div aria-hidden="true" class="mt-5 flex items-baseline gap-3">
    <span class="font-display text-h2 text-chalk leading-none tabular-nums">{OVERALL_SCORE}</span>
    <span class="text-steel text-caption">/100</span>
    <span class="text-acid-green text-caption ml-auto font-mono tracking-wide">{TREND_LABEL}</span>
  </div>

  <dl aria-hidden="true" class="mt-6 flex flex-col gap-3">
    {
      DIMENSIONS.map(({ name, score }) => (
        <div class="flex items-center gap-3">
          <dt class="text-steel text-caption w-32 shrink-0">{name}</dt>
          <dd class="flex flex-1 items-center gap-3">
            <div class="bg-asphalt relative h-1.5 flex-1 overflow-hidden rounded-full">
              <div
                class="bg-chalk absolute inset-y-0 left-0 rounded-full"
                style={`width: ${score}%`}
              />
            </div>
            <span class="text-chalk text-caption w-6 text-right font-mono tabular-nums">
              {score}
            </span>
          </dd>
        </div>
      ))
    }
  </dl>

  <p
    aria-hidden="true"
    class="text-steel/70 text-caption border-steel/10 mt-6 border-t pt-4 font-mono tracking-wide"
  >
    {SESSION_FOOTER}
  </p>
</figure>
