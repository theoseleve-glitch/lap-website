---
// T034 — final CTA block. Pricing snippet + 14-day trial CTA per
// 01-STRATEGIC-DOCTRINE.md §8 (€15/month or €150/year, single tier,
// 14-day full-feature free trial) and §10 bullet 3 (price does not
// move up during the 6 months). The CTA text + href mirror the T025
// hero primary so the hero and the page-close are recognizably the
// same commitment. A small link to /pricing (T057) hands off to the
// full tier card for readers who want the detailed breakdown.

const PRIMARY_CTA = {
  text: 'Start 14-day trial',
  href: 'https://app.lap-coach.racing/signup',
};

const HEADING_ID = 'final-cta-heading';
---

<section
  aria-labelledby={HEADING_ID}
  class="px-grid-margin border-steel/10 mx-auto w-full max-w-6xl border-t py-24 text-center sm:py-32"
>
  <div class="mx-auto max-w-prose">
    <p class="text-steel text-caption tracking-wide uppercase">Start today</p>
    <h2 id={HEADING_ID} class="font-display text-h2 text-chalk tracking-display mt-4 text-balance">
      Ready to make your next session count?
    </h2>
    <p class="text-steel text-body mt-5">
      Fourteen days free. Then €15 a month, or €150 a year and save €30.
    </p>

    <div class="mt-10">
      <a
        href={PRIMARY_CTA.href}
        rel="noopener"
        class="bg-chalk text-asphalt hover:bg-chalk/90 focus-visible:outline-chalk text-body inline-flex items-center justify-center px-7 py-3 font-medium transition"
      >
        {PRIMARY_CTA.text}
      </a>
    </div>

    <p class="text-steel/80 text-caption mt-6 font-mono tracking-wide">
      No card at signup · Cancel anytime
    </p>

    <p class="mt-8">
      <a
        href="/pricing"
        class="text-steel hover:text-chalk focus-visible:outline-chalk text-caption underline underline-offset-4 transition"
      >
        See full pricing &rarr;
      </a>
    </p>
  </div>
</section>
