---
interface CallToAction {
  text: string;
  href: string;
}

interface Props {
  headline: string;
  subhead: string;
  primaryCta: CallToAction;
  secondaryCta: CallToAction;
}

const { headline, subhead, primaryCta, secondaryCta } = Astro.props;

// The primary CTA links to app.lap-coach.racing; treat any app-subdomain
// link as an external origin so we get rel=noopener for safety without
// giving up same-tab flow (target stays default, matching Fitts' Law for
// trial-signup conversion).
const primaryIsExternal = /^https?:\/\//.test(primaryCta.href);
const secondaryIsExternal = /^https?:\/\//.test(secondaryCta.href);
---

<section
  class="room relative flex min-h-[calc(100vh-4rem)] flex-col items-center justify-center px-6 py-24 text-center sm:py-32"
>
  <p class="font-telemetry text-pit-orange mb-6">01 / START GRID · GREEN FLAG</p>
  <h1
    data-hero-animate
    class="font-display font-monument text-h1 text-shimmer max-w-wide tracking-display text-balance"
  >
    {headline}
  </h1>
  <p data-hero-animate class="text-steel text-body font-body mt-6 max-w-prose">{subhead}</p>
  <div data-hero-animate class="mt-10 flex flex-col gap-4 sm:flex-row sm:gap-5">
    <a
      href={primaryCta.href}
      rel={primaryIsExternal ? 'noopener' : undefined}
      class="bg-pit-orange text-asphalt hover:bg-pit-orange/90 focus-visible:outline-pit-orange text-body font-mono inline-flex items-center justify-center px-7 py-3 font-medium tracking-wide uppercase transition"
    >
      {primaryCta.text}
    </a>
    <a
      href={secondaryCta.href}
      rel={secondaryIsExternal ? 'noopener' : undefined}
      class="text-chalk border-pit-orange/40 hover:border-pit-orange focus-visible:outline-chalk text-body font-mono inline-flex items-center justify-center border px-7 py-3 tracking-wide uppercase transition"
    >
      {secondaryCta.text}
    </a>
  </div>
  <div data-hero-animate class="mt-16 w-full max-w-md">
    <slot name="visual" />
  </div>
</section>

<script>
  import '../scripts/hero-motion';
</script>
