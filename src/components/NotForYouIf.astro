---
// T033 — anti-persona disclosure. One bullet per anti-persona from
// 01-STRATEGIC-DOCTRINE.md §3: racing team engineers, drivers with a
// dedicated human coach, sponsored semi-pro programmes, and one-
// session-a-month casuals. This section is the honest close to the
// qualification arc — T031 affirmed fit, T032 framed against the
// category, T033 says out loud who should not buy. The "keep MoTeC"
// clause mirrors T032 so the non-displacement signal is consistent.

interface AntiBullet {
  lead: string;
  body: string;
}

const BULLETS: AntiBullet[] = [
  {
    lead: 'You are a racing team engineer.',
    body: 'Damper histograms, FFT on suspension travel, per-setup change loops — keep MoTeC. LAP is built for the driver, not the engineer behind the driver.',
  },
  {
    lead: 'You already work with a dedicated human coach.',
    body: 'A good coach solves a different problem — personal, expensive, hard to schedule. LAP is the opposite: always-on, €15 a month, no coach to reach. If you have a coach and it is working, keep the coach.',
  },
  {
    lead: 'You race in a fully sponsored, semi-pro series.',
    body: 'At that level the budgets, the stakes, and the feedback channels are different. LAP is priced and scoped for serious amateurs, not for teams with a race engineer on the pit wall.',
  },
  {
    lead: 'You log one session a month and want a pretty graph.',
    body: 'LAP improves because you give it a dozen sessions to learn from — baselines, patterns, prescription loops. One data point a month is nothing to measure against; a free logger will do the graph for you.',
  },
];

const HEADING_ID = 'not-for-you-if-heading';
---

<section
  aria-labelledby={HEADING_ID}
  class="px-grid-margin border-steel/10 mx-auto w-full max-w-6xl border-t py-24 sm:py-32"
>
  <header class="max-w-prose">
    <p class="text-steel text-caption tracking-wide uppercase">Who this isn&apos;t for</p>
    <h2 id={HEADING_ID} class="font-display text-h2 text-chalk tracking-display mt-4 text-balance">
      Not for you if&hellip;
    </h2>
    <p class="text-steel text-body mt-5">
      Four cases where LAP will not do what you need. Better to know now than four days into a
      trial.
    </p>
  </header>

  <ul class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-6">
    {
      BULLETS.map((b) => (
        <li class="border-steel/15 bg-concrete/40 rounded-2 flex flex-col border p-6 md:p-7">
          <p class="text-chalk text-body font-medium">{b.lead}</p>
          <p class="text-steel text-body leading-body mt-2">{b.body}</p>
        </li>
      ))
    }
  </ul>
</section>
