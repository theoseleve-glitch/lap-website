---
// T061 — FAQ accordion for /pricing. 10 questions the primary
// persona (01-STRATEGIC-DOCTRINE.md §3) actually asks before
// starting a subscription. Uses native <details>/<summary> so the
// accordion is fully keyboard-accessible, ARIA-native, and zero
// JS — honouring CLAUDE.md's "Prefer no JS unless interactivity
// needed" rule.
//
// Every answer traces to doctrine:
//   Q1 trial/card      → §8 "14-day full-feature free trial"
//   Q2 cancel          → industry-standard + cancel-anytime
//                        commitment in T034/T060 fine print
//   Q3 export          → §10 "never lose a session" extended to
//                        user data-portability
//   Q4 sim support     → §3 persona list + §5 DOES capture roster
//   Q5 offline         → §4 principle 5 "offline-first on capture"
//   Q6 real-world      → §5 RaceBox + iPhone capture surface
//   Q7 OS              → honest scope statement (Windows-only
//                        in this plan; Mac/Linux not roadmap)
//   Q8 price change    → §10 bullet 3 standard locked + §10
//                        bullet 5 waitlist grandfathering
//   Q9 language model  → §4 principle 4 / §10 bullet 4 no LLM
//   Q10 public beta    → §9 launch calendar (2026-07-23)

interface Faq {
  question: string;
  answer: string;
}

const FAQS: Faq[] = [
  {
    question: 'Do I need a credit card to start the trial?',
    answer:
      'No. The 14-day trial needs only your email. You enter payment details at the end of the trial if you decide to continue.',
  },
  {
    question: 'Can I cancel anytime?',
    answer:
      'Yes. Cancel from the dashboard at any time. If you cancel during the trial, nothing is charged. If you cancel a paid plan, it runs until the end of the current billing period.',
  },
  {
    question: 'Can I export my data?',
    answer:
      'Yes. Every session finalised in LAP is yours — exportable as the canonical session bundle plus a CSV of the derived metrics, at any time, whether you stay or leave.',
  },
  {
    question: 'Which sims are supported today?',
    answer:
      'iRacing, Assetto Corsa Competizione, AMS2, rFactor 2, Le Mans Ultimate, Rennsport, and F1 24. Other titles are on the roadmap.',
  },
  {
    question: 'Does capture work offline?',
    answer:
      'Yes. Desktop sim capture and mobile real-world capture both run without network — sessions finalise locally and sync when you come back online. Coaching views, progression, and benchmarks are cloud-only by design.',
  },
  {
    question: 'How does real-world capture work?',
    answer:
      'Pair a RaceBox with the iPhone app and drop the phone on the dash. Sessions finalise on the device and sync to your profile when you leave the track.',
  },
  {
    question: 'Which operating systems does the desktop app support?',
    answer:
      'Windows 10 and 11. macOS and Linux are not on the roadmap in the current 6-month plan.',
  },
  {
    question: 'Will my price change?',
    answer:
      'The standard €15 / month rate is locked through the current 6-month plan. Waitlist signups keep their €12 / month rate for the full 12 months regardless of any price change.',
  },
  {
    question: 'Is the coaching library written by a language model?',
    answer:
      'No. Every drill in LAP is a hand-written rule from a coaching library we curate and test against real sessions. Language models do not write coaching text — a strategic commitment, not a technical limit.',
  },
  {
    question: 'What happens when public beta opens?',
    answer:
      'Public beta opens at the end of July 2026. Users who paid during closed beta stay on their existing plan; the grandfathered waitlist rate remains intact for the full 12 months from the first paid month.',
  },
];

const HEADING_ID = 'pricing-faq-heading';
---

<section
  aria-labelledby={HEADING_ID}
  class="px-grid-margin border-steel/10 mx-auto mt-24 w-full max-w-6xl border-t pt-24 sm:mt-32 sm:pt-32"
>
  <header class="max-w-prose">
    <p class="text-steel text-caption tracking-wide uppercase">FAQ</p>
    <h2 id={HEADING_ID} class="font-display text-h2 text-chalk tracking-display mt-4 text-balance">
      Common questions.
    </h2>
  </header>

  <div class="mt-12 flex flex-col gap-3">
    {
      FAQS.map((faq) => (
        <details class="border-steel/15 bg-concrete/40 rounded-2 group border">
          <summary class="text-chalk flex cursor-pointer items-center justify-between gap-4 p-6 font-medium">
            <span>{faq.question}</span>
            <span
              class="text-steel shrink-0 transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <div class="border-steel/10 border-t px-6 pt-4 pb-6">
            <p class="text-steel text-body leading-body">{faq.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>
