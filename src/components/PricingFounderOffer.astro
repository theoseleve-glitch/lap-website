---
// T060 — grandfathered waitlist offer section. Doctrine source:
// 01-STRATEGIC-DOCTRINE.md §8 ("Existing pre-launch signups
// (waitlist): grandfathered at €12/month for 12 months as a
// loyalty signal") + §10 bullet 5 ("any change to pricing or
// feature availability preserves terms for pre-launch waitlist
// signups"). The offer is durable — the §10 commitment is what
// turns a one-time promo into a trust signal.
//
// No CTA to /waitlist today because that route is T091 scope
// (Block F). Adding a live link to a 404 route would be a broken
// promise; shipping the text-only offer is the honest interim
// state until the waitlist form lands.

const HEADING_ID = 'pricing-founder-offer-heading';
---

<section
  aria-labelledby={HEADING_ID}
  class="px-grid-margin border-steel/10 mx-auto mt-24 w-full max-w-6xl border-t pt-24 sm:mt-32 sm:pt-32"
>
  <article
    class="border-steel/15 bg-concrete/40 rounded-2 mx-auto flex max-w-2xl flex-col border p-8 sm:p-10"
  >
    <p class="text-acid-green text-caption tracking-wide uppercase">Early supporter offer</p>
    <h2 id={HEADING_ID} class="font-display text-h3 text-chalk tracking-display mt-4 text-balance">
      Signed up before launch? €12 a month for 12 months.
    </h2>
    <p class="text-steel text-body leading-body mt-5">
      Waitlist members who joined before public beta pay €12 a month (€3 under standard) for 12
      months from the first paid month. The terms preserve across any future pricing change — a
      loyalty signal, not a launch promo.
    </p>
  </article>
</section>
