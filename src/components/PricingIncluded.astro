---
// T059 — "What's included" checklist for the single tier. The 12
// bullets map 1:1 to 01-STRATEGIC-DOCTRINE.md §5 DOES list, so every
// item on this page traces to a doctrine-backed shippable feature.
// No invented capabilities, no inflated roster. Copy is
// user-benefit-oriented rather than implementation-speak (e.g.,
// "weakness detection" instead of "WeaknessEpisode object"), so a
// prospective buyer reads outcomes, not schemas.

const ITEMS: string[] = [
  'Sim capture — iRacing, ACC, AMS2, rFactor 2, LMU, Rennsport, and F1 titles.',
  'Real-world capture via RaceBox or an iPhone on the dash.',
  'Live overlays while you drive (desktop).',
  'Live coaching prompts during the session (desktop and mobile).',
  'Race strategy — sprint, endurance, and an armed pit-call.',
  'Session finalise with integrity checksums (never lose a session).',
  'Weakness detection and drill prescription across every session.',
  'Unified Driver Timeline — sim and real-world laps in one view.',
  'Sim↔real pairing with shape-and-intensity comparison.',
  'Next-session plans with measurable targets and three-verdict outcomes.',
  'Rule-based coaching library, hand-curated (80+ rules at V1).',
  'iRacing weekly and special-event calendar auto-ingest.',
];

const HEADING_ID = 'pricing-included-heading';
---

<section
  aria-labelledby={HEADING_ID}
  class="px-grid-margin border-steel/10 mx-auto mt-24 w-full max-w-6xl border-t pt-24 sm:mt-32 sm:pt-32"
>
  <header class="max-w-prose">
    <p class="text-steel text-caption tracking-wide uppercase">Every plan</p>
    <h2 id={HEADING_ID} class="font-display text-h2 text-chalk tracking-display mt-4 text-balance">
      What&rsquo;s included.
    </h2>
    <p class="text-steel text-body mt-5">
      Monthly and yearly plans ship the same product — no feature-gated tiers, no add-ons, no
      surprises behind a paywall.
    </p>
  </header>

  <ul class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-x-10 md:gap-y-5">
    {
      ITEMS.map((item) => (
        <li class="text-steel text-body leading-body flex gap-3">
          <span class="text-acid-green shrink-0" aria-hidden="true">
            ✓
          </span>
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</section>
