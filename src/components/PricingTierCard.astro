---
// T058 — single-tier pricing card per 01-STRATEGIC-DOCTRINE.md §8
// ("€15/month or €150/year (≈€12.50/month). Single tier.") + §10
// bullet 3 ("€15/month core tier — price does not move up during
// the 6 months"). Two CTAs wire to the lap-webapp signup flow with
// ?plan=monthly / ?plan=yearly query parameters that the signup
// handler reads to pre-select billing cadence. T063 adds formal
// wiring verification on top of these hrefs.

const MONTHLY_HREF = 'https://www.lap-coach.racing/register?plan=monthly';
const YEARLY_HREF = 'https://www.lap-coach.racing/register?plan=yearly';
const HEADING_ID = 'pricing-tier-heading';
---

<section aria-labelledby={HEADING_ID} class="mx-auto mt-16 w-full max-w-2xl sm:mt-20">
  <article class="border-steel/15 bg-concrete/40 rounded-2 flex flex-col border p-8 sm:p-10">
    <p
      class="bg-chalk text-asphalt text-caption inline-flex self-start rounded-full px-3 py-1 font-medium tracking-wide"
    >
      14-day free trial
    </p>

    <h2 id={HEADING_ID} class="font-display text-h3 text-chalk tracking-display mt-6 text-balance">
      Full LAP access.
    </h2>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-6">
      <div class="border-steel/10 rounded-2 flex flex-col border p-6">
        <p class="text-steel text-caption tracking-wide uppercase">Monthly</p>
        <p class="font-display text-h2 text-chalk tracking-display mt-3 tabular-nums">
          €15<span class="text-steel text-body ml-1 font-normal">/ month</span>
        </p>
        <a
          href={MONTHLY_HREF}
          rel="noopener"
          class="bg-chalk text-asphalt hover:bg-chalk/90 focus-visible:outline-chalk text-body mt-6 inline-flex items-center justify-center px-6 py-3 font-medium transition"
        >
          Start monthly
        </a>
      </div>

      <div class="border-steel/10 rounded-2 flex flex-col border p-6">
        <p class="text-steel text-caption tracking-wide uppercase">Yearly</p>
        <p class="font-display text-h2 text-chalk tracking-display mt-3 tabular-nums">
          €150<span class="text-steel text-body ml-1 font-normal">/ year</span>
        </p>
        <p class="text-acid-green text-caption mt-2 font-mono tracking-wide">save €30</p>
        <a
          href={YEARLY_HREF}
          rel="noopener"
          class="bg-chalk text-asphalt hover:bg-chalk/90 focus-visible:outline-chalk text-body mt-6 inline-flex items-center justify-center px-6 py-3 font-medium transition"
        >
          Start yearly
        </a>
      </div>
    </div>

    <p class="text-steel/80 text-caption mt-8 font-mono tracking-wide">
      No card at signup · Cancel anytime from the dashboard.
    </p>
  </article>
</section>
