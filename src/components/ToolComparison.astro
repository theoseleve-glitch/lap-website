---
// T032 — "Compare to tools you know" section. Positioning follows
// 01-STRATEGIC-DOCTRINE.md §3 persona ("has tried Garage61 / RaceLab /
// MoTeC — found them either too shallow or too pro-engineer") and §3
// anti-personas ("Professional racing team engineers → MoTeC exists").
// The section carves out LAP's space WITHOUT claiming to replace
// MoTeC for engineers — the "keep MoTeC" clause is the explicit
// trust signal. Bridge bullet (§4 principle 7) closes the set.

interface ComparisonCard {
  heading: string;
  body: string;
}

const CARDS: ComparisonCard[] = [
  {
    heading: 'Garage61: your laps. LAP: your next session.',
    body: 'Garage61 gives you deltas and stint summaries — the raw view. LAP starts where that ends: a named weakness, a drill sized to one session, and a measurable pass / fail next time out.',
  },
  {
    heading: 'MoTeC: for race engineers. LAP: for drivers.',
    body: 'If you want damper histograms and FFTs, keep MoTeC — it is the right tool for that job. LAP scopes to what the driver controls: braking release, throttle pickup, minimum speed, consistency.',
  },
  {
    heading: 'Sim and real share one profile. Nobody else tries.',
    body: 'One session format across iRacing, ACC, AMS2, RaceBox, and a phone on your dash — so an improvement on Tuesday’s GT3 practice shows up in Saturday’s track day at the same corner.',
  },
];

const HEADING_ID = 'tool-comparison-heading';
---

<section
  aria-labelledby={HEADING_ID}
  class="px-grid-margin border-steel/10 mx-auto w-full max-w-6xl border-t py-24 sm:py-32"
>
  <header class="max-w-prose">
    <p class="text-steel text-caption tracking-wide uppercase">The comparison</p>
    <h2 id={HEADING_ID} class="font-display text-h2 text-chalk tracking-display mt-4 text-balance">
      Coming from Garage61 or MoTeC.
    </h2>
    <p class="text-steel text-body mt-5">
      Every serious sim racer has opened both. Here is where LAP sits alongside them — and where it
      does not try to compete.
    </p>
  </header>

  <ul class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-6">
    {
      CARDS.map((card) => (
        <li class="flex">
          <article class="border-steel/15 bg-concrete/40 rounded-2 flex flex-1 flex-col border p-7">
            <h3 class="font-display text-h4 text-chalk tracking-display text-balance">
              {card.heading}
            </h3>
            <p class="text-steel text-body leading-body mt-4">{card.body}</p>
          </article>
        </li>
      ))
    }
  </ul>
</section>
