---
interface FooterColumn {
  heading: string;
  links: { label: string; href: string }[];
}

const COLUMNS: FooterColumn[] = [
  {
    heading: 'Product',
    links: [
      { label: 'Product', href: '/product' },
      { label: 'How it works', href: '/how-it-works' },
      { label: 'Pricing', href: '/pricing' },
      { label: 'Demo', href: '/demo' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'Press', href: '/press' },
      { label: 'Blog', href: '/blog' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy' },
      { label: 'Refund policy', href: '/refund-policy' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer
  role="contentinfo"
  class="border-steel/20 bg-asphalt px-grid-margin text-chalk mt-12 border-t py-8"
>
  <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
    {
      COLUMNS.map((column) => (
        <div>
          <h2 class="font-telemetry text-tiny text-steel mb-3">{column.heading}</h2>
          <ul class="space-y-2">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-body text-caption text-chalk hover:text-chalk/80 transition-opacity"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="flex flex-col items-start gap-3">
      <span class="font-monument text-h3 text-chalk">LAP</span>
      <p class="font-body text-caption text-steel">
        © {year} LAP. Every lap, one step better.
      </p>
    </div>
  </div>
</footer>
