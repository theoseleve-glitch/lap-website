---
import LapWordmark from './LapWordmark.astro';
import SectorTabs from './SectorTabs.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// One membership, one entry point. The trial starts in the webapp signup flow.
const PRIMARY_CTA = { text: 'Start free trial', href: '/register' };
const LOGIN_HREF = '/login';
---

<header
  role="banner"
  class="z-nav border-pit-orange/20 bg-asphalt/85 px-grid-margin before:via-pit-orange/50 sticky top-0 border-b py-3 backdrop-blur-md before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-gradient-to-r before:from-transparent before:to-transparent"
>
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4">
    <LapWordmark />

    <div class="hidden md:flex">
      <SectorTabs currentPath={currentPath} />
    </div>

    <div class="flex items-center gap-3">
      <a
        href={LOGIN_HREF}
        data-header-login
        class="text-steel hover:text-chalk focus-visible:outline-pit-orange text-caption hidden items-center justify-center px-3 py-2 font-mono font-medium tracking-wide uppercase transition md:inline-flex"
      >
        Sign in
      </a>
      <a
        href={PRIMARY_CTA.href}
        rel="noopener"
        data-header-cta
        class="cta-nowrap bg-pit-orange-deep text-asphalt hover:bg-pit-orange-deep/90 focus-visible:outline-pit-orange text-caption inline-flex items-center justify-center px-4 py-2 font-mono font-medium tracking-wide uppercase transition"
      >
        {PRIMARY_CTA.text}
      </a>
    </div>
  </div>
</header>
