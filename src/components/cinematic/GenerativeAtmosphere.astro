---
/**
 * GenerativeAtmosphere — the cinematic backdrop. A server-rendered SVG telemetry
 * field (graphite gradient + faint instrument grid + seeded speed traces + a
 * racing-line accent). Absolutely positioned, aria-hidden, pointer-events:none.
 *
 * Modes:
 *  - transparent: drop the gradient + grid so it can layer OVER a photo.
 *  - animate: the traces draw in once on load (stroke-dashoffset), reduced-motion
 *    safe. One-shot only — no looping.
 */
import { tracePath, racingLinePath } from '../../scripts/atmosphere';

interface Props {
  /** Seed for the trace geometry — vary per section for distinct fields. */
  seed?: number;
  /** hero = denser + dual glow; ambient = lighter (below-fold perf). */
  intensity?: 'hero' | 'ambient';
  /** Drop the background gradient + grid so traces layer over a photo. */
  transparent?: boolean;
  /** Draw the traces in once on load (one-shot, reduced-motion safe). */
  animate?: boolean;
  class?: string;
}

const {
  seed = 1207,
  intensity = 'ambient',
  transparent = false,
  animate = false,
  class: className = '',
} = Astro.props;

const W = 1200;
const H = 600;
const seeds =
  intensity === 'hero'
    ? [seed, seed + 11, seed + 23, seed + 37]
    : [seed, seed + 17];
const traces = seeds.map((s, i) => ({
  d: tracePath(s, W, H, 14),
  stroke: i % 2 === 0 ? 'var(--color-pit-orange)' : 'var(--color-acid-green)',
  opacity: Math.max(0.05, (transparent ? 0.16 : 0.1) - i * 0.015),
  extra: i >= 2,
}));
const racing = racingLinePath(seed, W, H);
---

<div
  class:list={[
    'gen-atmosphere',
    transparent ? 'is-transparent' : `is-${intensity}`,
    animate ? 'is-animate' : '',
    className,
  ]}
  aria-hidden="true"
>
  <svg
    class="gen-atmosphere__svg"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    {
      traces.map((t) => (
        <path
          d={t.d}
          fill="none"
          stroke={t.stroke}
          stroke-width="1.5"
          stroke-opacity={t.opacity}
          pathLength={animate ? 1 : undefined}
          class:list={['gen-trace', t.extra ? 'gen-trace--extra' : '']}
        />
      ))
    }
    <path
      d={racing}
      fill="none"
      stroke="var(--color-pit-orange)"
      stroke-width="1"
      stroke-opacity="0.1"
      stroke-dasharray="4 6"
      pathLength={animate ? 1 : undefined}
      class="gen-trace gen-trace--extra gen-trace--racing"
    />
  </svg>
</div>

<style>
  .gen-atmosphere {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .gen-atmosphere.is-ambient {
    background:
      var(--bcast-glow-gold),
      radial-gradient(
        120% 100% at 50% 0%,
        var(--color-graphite-2),
        var(--color-graphite) 55%,
        var(--color-asphalt) 100%
      );
  }
  .gen-atmosphere.is-hero {
    background:
      var(--bcast-glow-gold),
      var(--bcast-glow-green),
      radial-gradient(
        120% 120% at 50% -10%,
        var(--color-graphite-2),
        var(--color-graphite) 50%,
        var(--color-asphalt) 100%
      );
  }
  .gen-atmosphere.is-transparent {
    background: none;
  }
  .gen-atmosphere__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-image: var(--bg-grid);
    background-size: 56px 56px;
    opacity: 0.6;
  }
  .gen-atmosphere.is-transparent .gen-atmosphere__svg {
    background-image: none;
    opacity: 0.9;
  }

  /* One-shot draw-in for the traces (animate mode) — staggered, no loop. */
  .is-animate .gen-trace {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: gen-draw 1.8s var(--ease-reveal) forwards;
  }
  .is-animate .gen-trace:nth-child(2) {
    animation-delay: 0.15s;
  }
  .is-animate .gen-trace:nth-child(3) {
    animation-delay: 0.3s;
  }
  .is-animate .gen-trace:nth-child(4) {
    animation-delay: 0.45s;
  }
  .is-animate .gen-trace--racing {
    animation-delay: 0.6s;
  }
  @keyframes gen-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Mobile: drop the secondary traces to keep the SVG cheap for LCP. */
  @media (max-width: 640px) {
    .gen-trace--extra {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-animate .gen-trace {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
