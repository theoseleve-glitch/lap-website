---
/**
 * ProductShowcase — a high-fidelity, self-framed recreation of the LAP session-
 * analysis screen (browser chrome + 4-pillar score + speed trace + corner
 * time-loss). Represents the real product faithfully without a live capture;
 * labelled "Representative UI" for honesty. Pure CSS/SVG, no JS.
 */
import { tracePath } from '../../scripts/atmosphere';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const W = 600;
const H = 180;
const lap = tracePath(4242, W, H, 18);
const ref = tracePath(4242, W, H - 24, 18);

const pillars = [
  { label: 'Pace', value: 88 },
  { label: 'Consistency', value: 79 },
  { label: 'Execution', value: 84 },
  { label: 'Robustness', value: 77 },
];
const corners = [
  { name: 'T4 — late apex', delta: '−0.31s', tone: 'neg' },
  { name: 'T9 — early throttle', delta: '−0.22s', tone: 'neg' },
  { name: 'S2 — braking fixed', delta: '+0.18s', tone: 'pos' },
];
---

<figure class:list={['showcase', className]}>
  <div class="showcase__chrome" aria-hidden="true">
    <span class="showcase__dot"></span>
    <span class="showcase__dot"></span>
    <span class="showcase__dot"></span>
    <span class="showcase__addr">app.lap-coach.racing/sessions</span>
  </div>

  <div class="showcase__screen">
    <header class="showcase__head">
      <div>
        <p class="font-telemetry showcase__track">Spa-Francorchamps · GT3 · Dry</p>
        <p class="showcase__lap tabular-nums">1:42.318</p>
      </div>
      <div class="showcase__grade">
        <span class="showcase__score tabular-nums">82</span>
        <span class="showcase__score-max">/100</span>
        <span class="showcase__gradeletter">A</span>
      </div>
    </header>

    <div class="showcase__body">
      <div class="showcase__panel showcase__trace">
        <p class="font-telemetry showcase__panel-label">Speed trace · lap vs reference</p>
        <div class="showcase__svgwrap">
          <svg viewBox={`0 0 ${W} ${H}`} class="showcase__svg" preserveAspectRatio="none">
            <path
              d={ref}
              fill="none"
              stroke="var(--color-steel)"
              stroke-width="1.5"
              stroke-opacity="0.4"
              transform="translate(0,18)"
            />
            <path d={lap} fill="none" stroke="var(--color-acid-green)" stroke-width="2.5" />
          </svg>
          <span class="showcase__callout bcast-figure">−0.42s · T4</span>
        </div>
      </div>

      <div class="showcase__panel showcase__pillars">
        <p class="font-telemetry showcase__panel-label">Score breakdown</p>
        {
          pillars.map((p) => (
            <div class="showcase__pillar">
              <span class="showcase__pillar-label">{p.label}</span>
              <span class="showcase__bar">
                <span class="showcase__bar-fill" style={`width:${p.value}%`} />
              </span>
              <span class="showcase__pillar-val tabular-nums">{p.value}</span>
            </div>
          ))
        }
        <div class="showcase__corners">
          {
            corners.map((c) => (
              <div class="showcase__corner">
                <span class="showcase__corner-name">{c.name}</span>
                <span
                  class:list={[
                    'showcase__corner-delta bcast-figure',
                    c.tone === 'pos' ? 'is-pos' : 'is-neg',
                  ]}
                >
                  {c.delta}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <figcaption class="showcase__caption font-telemetry">Representative UI · session report</figcaption>
</figure>

<style>
  .showcase {
    margin: 0;
    border-radius: var(--radius-4);
    overflow: hidden;
    border: 1px solid var(--border-color-default);
    background: var(--color-concrete);
    box-shadow: var(--shadow-e4);
    position: relative;
  }
  .showcase::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: var(--bcast-glow-gold);
    opacity: 0.45;
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .showcase__chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 0.8rem;
    background: var(--color-graphite-2);
    border-bottom: 1px solid var(--border-color-muted);
  }
  .showcase__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--color-steel);
    opacity: 0.5;
  }
  .showcase__addr {
    margin-left: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    color: var(--color-steel);
    letter-spacing: var(--ls-medium);
  }
  .showcase__screen {
    padding: clamp(1rem, 3vw, 1.75rem);
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(34, 197, 94, 0.05), transparent 60%),
      var(--color-asphalt);
  }
  .showcase__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .showcase__track {
    color: var(--color-pit-orange);
  }
  .showcase__lap {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-chalk);
    line-height: 1;
    margin-top: 0.35rem;
  }
  .showcase__grade {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }
  .showcase__score {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--color-pit-orange);
    line-height: 1;
  }
  .showcase__score-max {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--color-steel);
  }
  .showcase__gradeletter {
    margin-left: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h4);
    color: var(--color-acid-green);
    border: 1px solid color-mix(in srgb, var(--color-acid-green) 50%, transparent);
    border-radius: var(--radius-1);
    padding: 0 0.4rem;
  }
  .showcase__body {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .showcase__body {
      grid-template-columns: 1.3fr 1fr;
    }
  }
  .showcase__panel {
    background: color-mix(in srgb, var(--color-concrete) 70%, transparent);
    border: 1px solid var(--border-color-muted);
    border-radius: var(--radius-2);
    padding: 1rem;
  }
  .showcase__panel-label {
    color: var(--color-steel);
    margin-bottom: 0.75rem;
  }
  .showcase__svgwrap {
    position: relative;
  }
  .showcase__svg {
    width: 100%;
    height: clamp(110px, 18vw, 150px);
    display: block;
  }
  .showcase__callout {
    position: absolute;
    top: 8%;
    right: 6%;
    font-size: var(--text-caption);
    color: var(--color-safety-red);
    background: color-mix(in srgb, var(--color-asphalt) 80%, transparent);
    border: 1px solid var(--border-color-default);
    border-radius: var(--radius-1);
    padding: 0.2rem 0.45rem;
  }
  .showcase__pillar {
    display: grid;
    grid-template-columns: 5.5rem 1fr 2rem;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }
  .showcase__pillar-label {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    color: var(--color-chalk);
  }
  .showcase__bar {
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-steel) 25%, transparent);
    overflow: hidden;
  }
  .showcase__bar-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-pit-orange-deep), var(--color-pit-orange));
  }
  .showcase__pillar-val {
    font-size: var(--text-caption);
    color: var(--color-chalk);
    text-align: right;
  }
  .showcase__corners {
    margin-top: 1rem;
    border-top: 1px solid var(--border-color-muted);
    padding-top: 0.75rem;
  }
  .showcase__corner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.3rem 0;
  }
  .showcase__corner-name {
    font-size: var(--text-caption);
    color: var(--color-steel);
  }
  .showcase__corner-delta {
    font-size: var(--text-caption);
  }
  .showcase__corner-delta.is-neg {
    color: var(--color-safety-red);
  }
  .showcase__corner-delta.is-pos {
    color: var(--color-acid-green);
  }
  .showcase__caption {
    color: var(--color-steel);
    text-align: center;
    padding: 0.6rem;
    background: var(--color-graphite-2);
    border-top: 1px solid var(--border-color-muted);
  }
</style>
