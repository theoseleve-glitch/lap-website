---
/**
 * FoundingSpots — genuine founding-50 scarcity. Renders "<N> of 50 founding
 * spots left" ONLY when a real claimed-count is supplied; otherwise falls back
 * to a static "First 50 members · founding rate" label. Never fabricates or
 * animates the number — ethical urgency only, with no client-side timers.
 *
 * Count source: pages pass import.meta.env.PUBLIC_FOUNDING_CLAIMED (parsed int),
 * mirroring WaitlistCount's manual-env posture.
 */
interface Props {
  /** How many of the founding spots are already claimed. Omit/NaN => static. */
  claimed?: number;
  limit?: number;
  class?: string;
}
const { claimed, limit = 50, class: className = '' } = Astro.props;
const hasReal =
  typeof claimed === 'number' &&
  Number.isFinite(claimed) &&
  claimed >= 0 &&
  claimed <= limit;
const remaining = hasReal ? limit - (claimed as number) : null;
---

{
  hasReal ? (
    <p class:list={['founding-spots', className]} data-founding="live">
      <span class="founding-spots__num bcast-figure">{remaining}</span>
      <span class="founding-spots__label">of {limit} founding spots left</span>
    </p>
  ) : (
    <p
      class:list={['founding-spots founding-spots--static', className]}
      data-founding="static"
    >
      <span class="founding-spots__label">
        First {limit} members · founding rate
      </span>
    </p>
  )
}

<style>
  .founding-spots {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }
  .founding-spots__num {
    font-size: var(--text-h4);
    font-weight: 700;
    color: var(--color-pit-orange);
  }
  .founding-spots__label {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: var(--ls-medium);
    color: var(--color-steel);
  }
</style>
