---
// src/components/rooms/FiveRedLights.astro — Phase 3.2 / hero gate.
//
// V2 March press-and-hold start ritual. Five lights illuminate one by
// one (1 s each) while the user holds the HOLD button. Release after
// all 5 are lit → lights extinguish and the page smooth-scrolls to the
// element marked [data-after-hero]. Release early → lights extinguish,
// "TOO EARLY" feedback, retry from idle.
//
// Runs on Pointer Events (mouse + touch + pen) with pointer capture so
// the up event still lands if the user drags off the button. Keyboard
// fallback: hold Space or Enter while the hero is in view.
//
// SSR-safe: SSR emits the idle markup; the inline script attaches on
// page load.
---

<div
  class="flex flex-col items-center"
  data-five-red-lights
  data-start-lights
>
  <div
    role="img"
    aria-label="Five start lights"
    class="bg-asphalt border-steel/30 flex items-center justify-center gap-3 rounded-md border px-5 py-4 sm:gap-4 sm:px-7"
  >
    {[1, 2, 3, 4, 5].map((n) => (
      <span
        data-light={n}
        data-lit="false"
        aria-hidden="true"
        class="block h-10 w-10 rounded-full border border-safety-red/30 bg-asphalt shadow-[inset_0_0_8px_rgba(0,0,0,0.8)] transition-all duration-200 sm:h-14 sm:w-14"
      />
    ))}
  </div>

  <p
    data-status
    aria-live="polite"
    class="font-telemetry text-pit-orange mt-7 min-h-[1.5em] text-center tracking-widest"
  >
    PRESS &amp; HOLD TO BEGIN
  </p>

  <button
    type="button"
    data-hold
    aria-pressed="false"
    aria-label="Press and hold to start the lights-out sequence"
    class="bg-pit-orange-deep text-asphalt hover:bg-pit-orange-deep/90 focus-visible:outline-pit-orange data-[active=true]:bg-safety-red data-[active=true]:text-chalk font-mono mt-6 inline-flex w-48 cursor-pointer touch-none items-center justify-center px-7 py-4 font-medium tracking-[0.3em] uppercase transition select-none"
  >
    <span data-hold-label>HOLD</span>
  </button>

  <p class="font-telemetry text-steel/60 mt-5 text-center tracking-wider">
    Release after all five lights to launch.
  </p>
</div>

<style>
  [data-light][data-lit='true'] {
    background: var(--color-safety-red);
    border-color: var(--color-safety-red);
    box-shadow:
      0 0 18px rgba(255, 42, 42, 0.85),
      0 0 36px rgba(255, 42, 42, 0.45),
      inset 0 0 6px rgba(255, 255, 255, 0.25);
  }
  /* Tactile press affordance — slight inset shadow when actively held. */
  [data-hold][data-active='true'] {
    transform: translateY(1px);
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.4);
  }
</style>

<script>
  (() => {
    if (typeof window === 'undefined') return;
    const root = document.querySelector<HTMLElement>('[data-five-red-lights]');
    if (!root) return;

    const lights = Array.from(root.querySelectorAll<HTMLElement>('[data-light]'));
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const button = root.querySelector<HTMLButtonElement>('[data-hold]')!;
    const label = root.querySelector<HTMLElement>('[data-hold-label]')!;

    const REVEAL_MS = 1000;
    const TOTAL = lights.length;

    type State = 'idle' | 'pressing' | 'ready' | 'released' | 'aborted';
    let state: State = 'idle';
    let timers: number[] = [];
    let resetTimer = 0;

    const setLights = (n: number) => {
      lights.forEach((node, i) => {
        node.dataset.lit = i < n ? 'true' : 'false';
      });
    };

    const clearAllTimers = () => {
      timers.forEach((t) => window.clearTimeout(t));
      timers = [];
      if (resetTimer) {
        window.clearTimeout(resetTimer);
        resetTimer = 0;
      }
    };

    const toIdle = () => {
      clearAllTimers();
      setLights(0);
      button.dataset.active = 'false';
      button.setAttribute('aria-pressed', 'false');
      label.textContent = 'HOLD';
      status.textContent = 'PRESS & HOLD TO BEGIN';
      state = 'idle';
    };

    const start = () => {
      if (state === 'pressing' || state === 'ready') return;
      clearAllTimers();
      state = 'pressing';
      button.dataset.active = 'true';
      button.setAttribute('aria-pressed', 'true');
      label.textContent = 'HOLDING…';
      status.textContent = 'STEADY…';
      setLights(0);

      for (let i = 1; i <= TOTAL; i++) {
        timers.push(
          window.setTimeout(() => {
            if (state !== 'pressing') return;
            setLights(i);
            if (i === TOTAL) {
              state = 'ready';
              status.textContent = 'RELEASE TO LAUNCH';
            }
          }, i * REVEAL_MS),
        );
      }
    };

    const scrollToNext = () => {
      const next =
        document.querySelector<HTMLElement>('[data-after-hero]') ??
        document.querySelector<HTMLElement>('main > * + *');
      if (next && typeof next.scrollIntoView === 'function') {
        next.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    const release = () => {
      if (state !== 'pressing' && state !== 'ready') return;
      const wasReady = state === 'ready';
      clearAllTimers();
      button.dataset.active = 'false';
      button.setAttribute('aria-pressed', 'false');
      label.textContent = 'HOLD';

      if (wasReady) {
        state = 'released';
        setLights(0);
        status.textContent = 'GO!';
        // Brief beat so the lights-out moment registers visually before scroll.
        window.setTimeout(scrollToNext, 220);
        // Reset hero so a return visit (scroll-up) shows idle prompt again.
        resetTimer = window.setTimeout(toIdle, 1600);
      } else {
        state = 'aborted';
        setLights(0);
        status.textContent = 'TOO EARLY — TRY AGAIN';
        resetTimer = window.setTimeout(() => {
          if (state === 'aborted') toIdle();
        }, 1400);
      }
    };

    // ── Pointer (mouse + touch + pen) ────────────────────────────────
    button.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      try {
        button.setPointerCapture(e.pointerId);
      } catch {
        /* pointer capture is best-effort */
      }
      start();
    });
    button.addEventListener('pointerup', (e) => {
      e.preventDefault();
      release();
    });
    button.addEventListener('pointercancel', release);
    button.addEventListener('lostpointercapture', release);

    // Defensive: if the document loses visibility mid-press, treat as release.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && (state === 'pressing' || state === 'ready')) {
        toIdle();
      }
    });

    // ── Keyboard (Space / Enter held while hero is in view) ──────────
    let kbHeld = false;
    const heroInView = () => {
      const rect = root.getBoundingClientRect();
      return rect.bottom > 0 && rect.top < window.innerHeight * 0.6;
    };
    window.addEventListener('keydown', (e) => {
      if (e.code !== 'Space' && e.code !== 'Enter') return;
      if (kbHeld) return; // ignore auto-repeat
      const target = e.target as HTMLElement | null;
      if (target && /^(input|textarea|select)$/i.test(target.tagName)) return;
      if (!heroInView()) return;
      e.preventDefault();
      kbHeld = true;
      start();
    });
    window.addEventListener('keyup', (e) => {
      if (e.code !== 'Space' && e.code !== 'Enter') return;
      if (!kbHeld) return;
      e.preventDefault();
      kbHeld = false;
      release();
    });
  })();
</script>
