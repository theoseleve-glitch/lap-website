---
// src/components/rooms/FiveRedLights.astro — Phase 3.1 / hero feature.
//
// F1 lights-out reaction game. Five lights illuminate one-by-one, all stay
// lit, then extinguish at a random delay between 0.5 and 3 s — the exact
// FIA Formula 1 race-start procedure. The user taps as fast as possible
// after lights-out. Reaction time in ms is shown, with a localStorage-
// backed personal best and the F1-driver benchmark (~200 ms).
//
// All state and timing live in the inline <script> below. The component is
// SSR-safe: SSR emits the idle markup; the script attaches on hydration.
---

<figure
  class="border-pit-orange/30 bg-concrete rounded-2 shadow-e3 mx-auto w-full max-w-md p-6 text-left"
  aria-label="Reaction-time game · F1 lights-out start procedure"
  data-five-red-lights
>
  <figcaption class="flex items-center justify-between">
    <span class="font-telemetry text-pit-orange">REACTION TEST · F1 START</span>
    <span class="font-telemetry text-steel/70" aria-hidden="true">FIA SEQUENCE</span>
  </figcaption>

  <div
    role="img"
    aria-label="Five start lights"
    class="bg-asphalt border-steel/30 mt-5 flex items-center justify-between gap-3 rounded-md border p-4"
  >
    {[1, 2, 3, 4, 5].map((n) => (
      <span
        data-light={n}
        data-lit="false"
        aria-hidden="true"
        class="block h-10 w-10 rounded-full border border-safety-red/30 bg-asphalt shadow-[inset_0_0_8px_rgba(0,0,0,0.8)] transition-all duration-200 sm:h-12 sm:w-12"
      />
    ))}
  </div>

  <p
    data-status
    aria-live="polite"
    class="font-telemetry text-chalk mt-4 min-h-[1.5em] text-center"
  >
    Press START. Tap when lights go out.
  </p>

  <button
    type="button"
    data-tap
    class="bg-pit-orange text-asphalt hover:bg-pit-orange/90 focus-visible:outline-pit-orange text-body font-mono mt-4 inline-flex w-full items-center justify-center px-7 py-3 font-medium tracking-wide uppercase transition"
  >
    <span data-tap-label>START</span>
  </button>

  <dl class="mt-5 grid grid-cols-2 gap-4 text-center">
    <div>
      <dt class="font-telemetry text-steel">YOUR LAST</dt>
      <dd
        data-result
        class="font-display font-monument text-h3 text-chalk tabular-nums leading-none mt-1"
      >
        — ms
      </dd>
    </div>
    <div>
      <dt class="font-telemetry text-steel">PERSONAL BEST</dt>
      <dd
        data-best
        class="font-display font-monument text-h3 text-pit-orange tabular-nums leading-none mt-1"
      >
        — ms
      </dd>
    </div>
  </dl>

  <p class="font-telemetry text-steel/70 mt-5 text-center">
    F1 driver: ~200 ms · Average: ~250 ms
  </p>
</figure>

<style>
  [data-light][data-lit='true'] {
    background: var(--color-safety-red);
    border-color: var(--color-safety-red);
    box-shadow:
      0 0 18px rgba(255, 42, 42, 0.85),
      0 0 36px rgba(255, 42, 42, 0.45),
      inset 0 0 6px rgba(255, 255, 255, 0.25);
  }
</style>

<script>
  (() => {
    if (typeof window === 'undefined') return;
    const root = document.querySelector<HTMLElement>('[data-five-red-lights]');
    if (!root) return;

    const lights = Array.from(root.querySelectorAll<HTMLElement>('[data-light]'));
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const button = root.querySelector<HTMLButtonElement>('[data-tap]')!;
    const label = root.querySelector<HTMLElement>('[data-tap-label]')!;
    const resultEl = root.querySelector<HTMLElement>('[data-result]')!;
    const bestEl = root.querySelector<HTMLElement>('[data-best]')!;

    const STORAGE_KEY = 'lap-five-red-lights-best';

    type State = 'idle' | 'arming' | 'waiting' | 'racing' | 'result' | 'jump';
    let state: State = 'idle';
    const armingTimers: number[] = [];
    let waitingTimer = 0;
    let startTime = 0;

    let storedBest = 0;
    try {
      storedBest = parseInt(localStorage.getItem(STORAGE_KEY) ?? '0', 10) || 0;
    } catch {
      storedBest = 0;
    }
    if (storedBest > 0) bestEl.textContent = `${storedBest} ms`;

    const setLights = (count: number) => {
      lights.forEach((node, i) => {
        node.dataset.lit = i < count ? 'true' : 'false';
      });
    };

    const clearTimers = () => {
      armingTimers.forEach((t) => window.clearTimeout(t));
      armingTimers.length = 0;
      if (waitingTimer) window.clearTimeout(waitingTimer);
      waitingTimer = 0;
    };

    const reactionVerdict = (ms: number) => {
      if (ms < 200) return 'Reaction god. Verstappen tier.';
      if (ms < 250) return 'F1-tier reaction. Try again?';
      if (ms < 300) return 'Quick. Try again?';
      if (ms < 400) return 'Average. Sharpen up — F1 drivers tap ~200 ms.';
      return 'Try again — F1 drivers tap ~200 ms.';
    };

    const arm = () => {
      state = 'arming';
      label.textContent = 'WAIT…';
      status.textContent = 'Steady…';
      resultEl.textContent = '— ms';
      setLights(0);

      for (let i = 1; i <= 5; i++) {
        armingTimers.push(
          window.setTimeout(() => setLights(i), i * 1000),
        );
      }

      armingTimers.push(
        window.setTimeout(() => {
          state = 'waiting';
          status.textContent = 'Wait for it…';
          const delay = 500 + Math.random() * 2500;
          waitingTimer = window.setTimeout(() => {
            setLights(0);
            startTime = performance.now();
            state = 'racing';
            label.textContent = 'TAP!';
            status.textContent = 'GO!';
          }, delay);
        }, 5500),
      );
    };

    const finishRace = () => {
      const ms = Math.round(performance.now() - startTime);
      state = 'result';
      resultEl.textContent = `${ms} ms`;
      status.textContent = reactionVerdict(ms);
      label.textContent = 'GO AGAIN';

      if (storedBest === 0 || ms < storedBest) {
        storedBest = ms;
        bestEl.textContent = `${ms} ms`;
        try {
          localStorage.setItem(STORAGE_KEY, String(ms));
        } catch {
          /* private mode / quota — silent */
        }
      }
    };

    const jumpStart = () => {
      clearTimers();
      setLights(0);
      state = 'jump';
      status.textContent = 'JUMP START — wait for lights out.';
      resultEl.textContent = '— ms';
      label.textContent = 'TRY AGAIN';
    };

    const tap = () => {
      switch (state) {
        case 'idle':
        case 'result':
        case 'jump':
          arm();
          break;
        case 'racing':
          finishRace();
          break;
        case 'arming':
        case 'waiting':
          jumpStart();
          break;
      }
    };

    button.addEventListener('click', tap);

    // Keyboard: Space or Enter when focused on the button already triggers
    // click natively. Add a window-level Space shortcut so a user reading
    // the hero can tap without scrolling, but only when the button is in
    // the viewport — avoids hijacking Space scrolling elsewhere on the
    // page. (Browsers fire keydown for Space — preventDefault stops the
    // scroll only when we actually consume the press.)
    let inView = false;
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) inView = e.isIntersecting;
        },
        { threshold: 0.4 },
      );
      io.observe(root);
    }

    window.addEventListener('keydown', (e) => {
      if (!inView) return;
      if (e.code !== 'Space' && e.code !== 'Enter') return;
      const target = e.target as HTMLElement | null;
      // If the user is typing in an input, leave Space alone.
      if (target && /^(input|textarea|select)$/i.test(target.tagName)) return;
      e.preventDefault();
      tap();
    });
  })();
</script>
