---
// src/components/rooms/HeroManifest.astro — Phase 3.2.
//
// The "rest of the website" target the StartGrid press-and-hold release
// scrolls to. Carries the doctrine-locked subhead (T024) and the hero CTA
// pair (T025 primary → signup, T026 secondary → /how-it-works) plus a
// small SIM-RACING badge that the V2 March hero used to display above
// the headline.
//
// The [data-after-hero] attribute on the section is the scroll target —
// FiveRedLights queries it on lights-out and calls scrollIntoView.

const PRIMARY = { text: 'Start 14-day trial', href: 'https://app.lap-coach.racing/signup' };
const SECONDARY = { text: 'See how it works', href: '/how-it-works' };
const SUBHEAD =
  'The cross-platform Driver OS that turns every sim and real-world session into measurable progress.';
---

<section
  data-after-hero
  aria-label="What LAP is"
  class="px-grid-margin mx-auto w-full max-w-6xl py-20 text-center sm:py-24"
>
  <p
    class="font-telemetry bg-pit-orange/10 text-pit-orange border-pit-orange/30 inline-block border px-3 py-1 tracking-[0.2em]"
  >
    SIM-RACING EARLY ACCESS NOW OPEN
  </p>

  <p class="text-chalk text-body font-body mx-auto mt-8 max-w-prose text-pretty">
    {SUBHEAD}
  </p>

  <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-5">
    <a
      href={PRIMARY.href}
      rel="noopener"
      class="bg-pit-orange text-asphalt hover:bg-pit-orange/90 focus-visible:outline-pit-orange text-body font-mono inline-flex items-center justify-center px-7 py-3 font-medium tracking-wide uppercase transition"
    >
      {PRIMARY.text}
    </a>
    <a
      href={SECONDARY.href}
      class="text-chalk border-pit-orange/40 hover:border-pit-orange focus-visible:outline-chalk text-body font-mono inline-flex items-center justify-center border px-7 py-3 tracking-wide uppercase transition"
    >
      {SECONDARY.text}
    </a>
  </div>
</section>
