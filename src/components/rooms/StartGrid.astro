---
// src/components/rooms/StartGrid.astro — Phase 3.2.
//
// V2 March entrance ritual. Pure minimalist 100vh hero: telemetry kicker,
// monument+shimmer headline, the five-red-lights press-and-hold gate.
// The doctrine-locked subhead and CTAs (T024 / T025 / T026) live in the
// HeroManifest section right below — that section also carries the
// [data-after-hero] anchor that the lights-out release smooth-scrolls to.
import FiveRedLights from './FiveRedLights.astro';

const HEADLINE = 'Every lap, one step better.';
---

<section
  class="room texture-grain px-grid-margin relative mx-auto flex min-h-screen w-full max-w-6xl flex-col items-center justify-center py-16 text-center sm:py-20"
  aria-label="Start grid — what is LAP"
>
  <p
    class="font-telemetry text-pit-orange mb-8 tracking-[0.3em]"
    data-hero-animate
  >
    01 / START GRID · GREEN FLAG
  </p>

  <h1
    data-hero-animate
    class="font-display font-monument text-shimmer text-h1 max-w-wide tracking-display text-balance"
  >
    {HEADLINE}
  </h1>

  <div data-hero-animate class="mt-14 sm:mt-16">
    <FiveRedLights />
  </div>
</section>

<script>
  import '../../scripts/hero-motion';
</script>
