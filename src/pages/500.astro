---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="500 — Server error · LAP"
  description="Something broke on our side. Try again, or head back to the LAP homepage."
>
  <main class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <h1 class="font-display text-h1">500 · Something went wrong</h1>
    <p class="text-steel text-body mt-6 max-w-prose">
      Something broke on our side. Try the page again in a moment — or head back to the homepage and
      take another line in.
    </p>
    <a
      href="/"
      class="text-chalk border-steel/40 hover:border-chalk text-body mt-10 inline-block border px-6 py-3 transition"
    >
      Return to LAP
    </a>
  </main>
</BaseLayout>
