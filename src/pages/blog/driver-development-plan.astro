---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PILLAR_4_FAQS, pillar4FaqJsonLd } from '../../data/pillar-4-faq';

// T170 — published Pillar 4 article. Closes the four-pillar
// cluster. Same pattern as T140 (sim-to-real-transfer), T150
// (what-is-trail-braking), T160 (best-sim-racing-telemetry-app):
// markdown-rendered body imports canonical editorial source from
// docs/pillar-articles/driver-development-plan/section-XX.md so
// the published page and the editorial workspace cannot drift
// apart.
//
// Indexing-submission step at Google Search Console is a manual
// post-deploy action — page is build-ready and indexable; once
// production deploys (depends on T008/T009/T010 deploy infra),
// the URL goes into GSC's URL Inspection tool for explicit crawl
// request, and the auto-generated sitemap.xml takes care of the
// recurring re-crawl signal.

import * as section01 from '../../../docs/pillar-articles/driver-development-plan/section-01-intro.md';
import * as section02 from '../../../docs/pillar-articles/driver-development-plan/section-02-what-is.md';
import * as section03 from '../../../docs/pillar-articles/driver-development-plan/section-03-framework.md';
import * as section04 from '../../../docs/pillar-articles/driver-development-plan/section-04-cadences.md';
import * as section05 from '../../../docs/pillar-articles/driver-development-plan/section-05-automation.md';
import * as section06 from '../../../docs/pillar-articles/driver-development-plan/section-06-diy-template.md';
import * as section07 from '../../../docs/pillar-articles/driver-development-plan/section-07-conclusion.md';

const { Content: Section01 } = section01;
const { Content: Section02 } = section02;
const { Content: Section03 } = section03;
const { Content: Section04 } = section04;
const { Content: Section05 } = section05;
const { Content: Section06 } = section06;
const { Content: Section07 } = section07;

const TITLE =
  'How to build a driver development plan: a five-verb framework for sustained progression';
const DESCRIPTION =
  'A driver development plan is a structured feedback loop tied to data, anchored on five framework verbs: diagnose, prescribe, execute, measure, adapt. The framework runs on three cadences (per-session, weekly, event-cycle) plus a DIY template that runs on any telemetry tool — the framework belongs to the reader regardless of which tool they pay for.';

const siteURL = Astro.site ?? new URL('https://lap-coach.racing/');
const pageURL = new URL(Astro.url.pathname, siteURL).toString();

const ARTICLE_PUBLISHED = '2026-04-26';
const ARTICLE_MODIFIED = '2026-04-26';
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'How to build a driver development plan',
  description: DESCRIPTION,
  url: pageURL,
  datePublished: ARTICLE_PUBLISHED,
  dateModified: ARTICLE_MODIFIED,
  author: {
    '@type': 'Organization',
    name: 'LAP',
    url: siteURL.toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'LAP',
    url: siteURL.toString(),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageURL,
  },
};

const faqJsonLd = pillar4FaqJsonLd();

const FAQ_HEADING_ID = 'pillar-4-faq-heading';
---

<BaseLayout title={TITLE} description={DESCRIPTION} ogType="article">
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <article class="max-w-prose">
      <header>
        <p class="text-acid-green text-caption tracking-wide uppercase">Driver development plan</p>
        <h1 class="font-display text-h1 text-chalk tracking-display mt-4 text-balance">
          How to build a driver development plan.
        </h1>
        <p class="text-steel text-body mt-6">
          Aimless practice is the default state. A development plan is the alternative — a
          structured feedback loop anchored on five framework verbs (diagnose, prescribe, execute,
          measure, adapt) and three cadences (per-session, weekly, event-cycle). The article walks
          through what a plan is, the framework, the cadences, how LAP automates each step, and a
          DIY template that runs on any telemetry tool you already own. The framework belongs to
          the reader regardless of which tool fills the rows.
        </p>
      </header>

      <div
        class="prose prose-invert text-steel mt-16 max-w-prose [&_a]:text-acid-green [&_a:hover]:underline [&_h2]:font-display [&_h2]:text-h3 [&_h2]:text-chalk [&_h2]:tracking-display [&_h2]:mt-16 [&_h2]:mb-6 [&_h3]:font-display [&_h3]:text-h4 [&_h3]:text-chalk [&_h3]:tracking-display [&_h3]:mt-10 [&_h3]:mb-4 [&_p]:my-4 [&_p]:leading-body [&_ul]:my-4 [&_ul]:pl-6 [&_ul]:list-disc [&_li]:my-2 [&_li]:leading-body [&_strong]:text-chalk [&_table]:my-6 [&_table]:w-full [&_table]:border-collapse [&_th]:border [&_th]:border-steel/20 [&_th]:p-2 [&_th]:text-chalk [&_th]:text-left [&_td]:border [&_td]:border-steel/15 [&_td]:p-2 [&_td]:align-top"
      >
        <Section01 />
        <Section02 />
        <Section03 />
        <Section04 />
        <Section05 />
        <Section06 />
        <Section07 />
      </div>
    </article>

    <section
      aria-labelledby={FAQ_HEADING_ID}
      class="border-steel/10 mx-auto mt-24 max-w-prose border-t pt-24 sm:mt-32 sm:pt-32"
    >
      <header>
        <p class="text-steel text-caption tracking-wide uppercase">FAQ</p>
        <h2
          id={FAQ_HEADING_ID}
          class="font-display text-h2 text-chalk tracking-display mt-4 text-balance"
        >
          Common questions.
        </h2>
      </header>

      <div class="mt-12 flex flex-col gap-3">
        {
          PILLAR_4_FAQS.map((faq) => (
            <details class="border-steel/15 bg-concrete/40 rounded-2 group border">
              <summary class="text-chalk flex cursor-pointer items-center justify-between gap-4 p-6 font-medium">
                <span>{faq.question}</span>
                <span
                  class="text-steel shrink-0 transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <div class="border-steel/10 border-t px-6 pt-4 pb-6">
                <p class="text-steel text-body leading-body">{faq.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(articleJsonLd)}
  />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
