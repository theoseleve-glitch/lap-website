---
import BaseLayout from '../../layouts/BaseLayout.astro';

// T211 — launch-day blog post "Introducing LAP". Drafted
// today (2026-04-26, Month 1) and scheduled for the
// public-beta launch day on 2026-07-23. Mirrors the
// publish-page shape of the Batch 2 founder posts (T189)
// minus the FAQ section — the post itself answers the
// announcement-style questions, and a launch announcement
// reads cleaner without an accordion section.

import * as post from '../../../docs/blog-posts/introducing-lap.md';

const { Content } = post;

const TITLE = 'Introducing LAP — public beta on 2026-07-23';
const DESCRIPTION =
  'Launch-day note from the founding team — what LAP is, what ships in public beta on 2026-07-23, what V1 adds on 2026-09-23, and how to join the waitlist for the grandfathered founder rate before launch.';

const siteURL = Astro.site ?? new URL('https://lap-coach.racing/');
const pageURL = new URL(Astro.url.pathname, siteURL).toString();

const ARTICLE_PUBLISHED = '2026-07-23';
const ARTICLE_MODIFIED = '2026-07-23';
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: TITLE,
  description: DESCRIPTION,
  url: pageURL,
  datePublished: ARTICLE_PUBLISHED,
  dateModified: ARTICLE_MODIFIED,
  author: {
    '@type': 'Organization',
    name: 'LAP',
    url: siteURL.toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'LAP',
    url: siteURL.toString(),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageURL,
  },
};
---

<BaseLayout
  title={TITLE}
  description={DESCRIPTION}
  ogType="article"
  ogImage="/og/blog/introducing-lap.svg"
>
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <article class="max-w-prose">
      <header>
        <p class="text-acid-green text-caption tracking-wide uppercase">
          Founder note · Public beta launch
        </p>
      </header>

      <div
        class="prose prose-invert text-steel mt-8 max-w-prose [&_a]:text-acid-green [&_a:hover]:underline [&_h1]:font-display [&_h1]:text-h1 [&_h1]:text-chalk [&_h1]:tracking-display [&_h1]:mt-4 [&_h1]:mb-6 [&_h1]:text-balance [&_h2]:font-display [&_h2]:text-h3 [&_h2]:text-chalk [&_h2]:tracking-display [&_h2]:mt-16 [&_h2]:mb-6 [&_h3]:font-display [&_h3]:text-h4 [&_h3]:text-chalk [&_h3]:tracking-display [&_h3]:mt-10 [&_h3]:mb-4 [&_p]:my-4 [&_p]:leading-body [&_ul]:my-4 [&_ul]:pl-6 [&_ul]:list-disc [&_li]:my-2 [&_li]:leading-body [&_strong]:text-chalk"
      >
        <Content />
      </div>
    </article>
  </main>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(articleJsonLd)}
  />
</BaseLayout>
