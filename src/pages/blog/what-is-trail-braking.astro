---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PILLAR_2_FAQS, pillar2FaqJsonLd } from '../../data/pillar-2-faq';

// T150 — published Pillar 2 article. Closes Pillar 2 sprint.
// Same pattern as T140 (sim-to-real-transfer): markdown-rendered
// body imports canonical editorial source from
// docs/pillar-articles/trail-braking/section-*.md so the
// published page and the editorial workspace cannot drift apart.
//
// Indexing-submission step at Google Search Console is a manual
// post-deploy action — page is build-ready and indexable; once
// production deploys (depends on T008/T009/T010 deploy infra),
// the URL goes into GSC's URL Inspection tool for explicit crawl
// request, and the auto-generated sitemap.xml takes care of the
// recurring re-crawl signal.

import * as section02 from '../../../docs/pillar-articles/trail-braking/section-02-physics.md';
import * as section03 from '../../../docs/pillar-articles/trail-braking/section-03-mistakes.md';
import * as section04 from '../../../docs/pillar-articles/trail-braking/section-04-detection.md';
import * as section05 from '../../../docs/pillar-articles/trail-braking/section-05-drills.md';
import * as section06 from '../../../docs/pillar-articles/trail-braking/section-06-examples.md';

const { Content: Section02 } = section02;
const { Content: Section03 } = section03;
const { Content: Section04 } = section04;
const { Content: Section05 } = section05;
const { Content: Section06 } = section06;

const TITLE = 'What is trail braking — and how to measure it in your own data';
const DESCRIPTION =
  'Trail braking is a release pattern, not a brake input. The physics that makes it work, the six common mistakes and their telemetry signatures, how LAP detects them automatically, and a three-tier drill progression to improve.';

const siteURL = Astro.site ?? new URL('https://lap-coach.racing/');
const pageURL = new URL(Astro.url.pathname, siteURL).toString();

const ARTICLE_PUBLISHED = '2026-04-25';
const ARTICLE_MODIFIED = '2026-04-25';
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'What is trail braking, and how to measure it',
  description: DESCRIPTION,
  url: pageURL,
  datePublished: ARTICLE_PUBLISHED,
  dateModified: ARTICLE_MODIFIED,
  author: {
    '@type': 'Organization',
    name: 'LAP',
    url: siteURL.toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'LAP',
    url: siteURL.toString(),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageURL,
  },
};

const faqJsonLd = pillar2FaqJsonLd();

const FAQ_HEADING_ID = 'pillar-2-faq-heading';
---

<BaseLayout title={TITLE} description={DESCRIPTION} ogType="article" ogImage="/og/blog/what-is-trail-braking.svg">
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <article class="max-w-prose">
      <header>
        <p class="text-acid-green text-caption tracking-wide uppercase">Trail braking</p>
        <h1 class="font-display text-h1 text-chalk tracking-display mt-4 text-balance">
          What is trail braking — and how to measure it.
        </h1>
        <p class="text-steel text-body mt-6">
          If there is one technique that separates intermediate drivers from fast ones, it is trail
          braking. The phrase shows up everywhere — coaches say "trail brake more", forum posts
          dissect a pro driver's brake-pressure trace overlapping with steering input — but the
          technique itself is straightforward: a disciplined release of brake pressure into corner
          entry that exploits a physics property of the tire. The article unpacks the physics,
          names the six common mistakes and their telemetry signatures, explains how LAP detects
          them automatically, sketches a practice progression, and walks through three real
          captured examples.
        </p>
      </header>

      <div
        class="prose prose-invert text-steel mt-16 max-w-prose [&_a]:text-acid-green [&_a:hover]:underline [&_h2]:font-display [&_h2]:text-h3 [&_h2]:text-chalk [&_h2]:tracking-display [&_h2]:mt-16 [&_h2]:mb-6 [&_h3]:font-display [&_h3]:text-h4 [&_h3]:text-chalk [&_h3]:tracking-display [&_h3]:mt-10 [&_h3]:mb-4 [&_p]:my-4 [&_p]:leading-body [&_ul]:my-4 [&_ul]:pl-6 [&_ul]:list-disc [&_li]:my-2 [&_li]:leading-body [&_strong]:text-chalk"
      >
        <Section02 />
        <Section03 />
        <Section04 />
        <Section05 />
        <Section06 />
      </div>
    </article>

    <section
      aria-labelledby={FAQ_HEADING_ID}
      class="border-steel/10 mx-auto mt-24 max-w-prose border-t pt-24 sm:mt-32 sm:pt-32"
    >
      <header>
        <p class="text-steel text-caption tracking-wide uppercase">FAQ</p>
        <h2
          id={FAQ_HEADING_ID}
          class="font-display text-h2 text-chalk tracking-display mt-4 text-balance"
        >
          Common questions.
        </h2>
      </header>

      <div class="mt-12 flex flex-col gap-3">
        {
          PILLAR_2_FAQS.map((faq) => (
            <details class="border-steel/15 bg-concrete/40 rounded-2 group border">
              <summary class="text-chalk flex cursor-pointer items-center justify-between gap-4 p-6 font-medium">
                <span>{faq.question}</span>
                <span
                  class="text-steel shrink-0 transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <div class="border-steel/10 border-t px-6 pt-4 pb-6">
                <p class="text-steel text-body leading-body">{faq.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(articleJsonLd)}
  />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
