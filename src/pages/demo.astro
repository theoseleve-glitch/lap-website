---
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoWalkthrough from '../components/DemoWalkthrough.astro';
import SocialProof from '../components/SocialProof.astro';
import FinalCta from '../components/FinalCta.astro';

// T072 — shell for /demo. The route is referenced from the sprint brief
// (Block E) as the "watch it work before you sign up" on-ramp. Shipping
// the shell means the secondary CTA path (hero → /demo) resolves to a
// real page instead of 404ing while T073 decided format (video; see
// DemoWalkthrough.astro), T074 lands the 3-minute walkthrough, T077
// pre-seeds the sample session, T085 wires the post-demo trial CTA
// (done — reuses the shared T034 FinalCta so the signup href stays in
// exactly one place), T086 mounts the testimonials placeholder between
// the walkthrough and the CTA (reuses the T035 SocialProof so the
// "no testimonials until beta" posture stays in one component), and
// T079-T090 cover perf, SEO, a11y, and e2e.

// Doctrine-aligned scent: the <title> + description set expectations
// before the visitor decides to watch. "Session walkthrough" matches
// T074's 3-min video content (one real session from capture → plan);
// "no sign-up required" names the friction we've removed, which is
// the single most relevant decision point for a cold visitor. Loop
// rule enforced: natural prose, not keyword soup.
//
// T088 — target keyword "sim racing telemetry demo". The title leads
// with the exact noun phrase so SERP snippets carry the match near
// the click; the description pairs "sim racing telemetry" with the
// concrete scent (three-minute walkthrough, one real session, no
// sign-up) so a visitor who clicked on the query arrives with the
// answer already visible. Natural prose — the phrase is used
// because it describes the page, not because the ranking function
// wanted it there.
const TITLE = 'Sim racing telemetry demo — LAP';
const DESCRIPTION =
  'A three-minute sim racing telemetry demo: watch one real session get captured, reviewed by the brain, and turned into the next session plan. No sign-up required.';
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <header class="max-w-prose">
      <p class="text-steel text-caption tracking-wide uppercase">Demo</p>
      <h1 class="font-display text-h1 text-chalk tracking-display mt-4 text-balance">
        See LAP in action.
      </h1>
      <p class="text-steel text-body mt-6">
        A three-minute session walkthrough — what gets captured, what the brain finds, and what the
        next session plan looks like. No sign-up required.
      </p>
    </header>

    <DemoWalkthrough />
    <SocialProof />
    <FinalCta />
  </main>
</BaseLayout>
