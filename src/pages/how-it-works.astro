---
import BaseLayout from '../layouts/BaseLayout.astro';

// T042 set up the shell; T043 lands the real hero. H1 copy is locked
// by the sprint task and mirrors the doctrine's category framing
// ("loop"). The subhead previews the four sections T045-T048 will
// build out — capture, brain, plan, improve — which map one-to-one
// to ADR-005 objects (§5 capture schema / §5.2-§5.4 backend brain /
// next-session plan / §5.1 DriverProgressSnapshot). SEO retuning
// per targeted keyword lands in T054.

const TITLE = 'How LAP works — LAP';
const DESCRIPTION =
  'The coaching loop, the sim↔real bridge, and the data model behind them — how LAP turns every sim and real-world session into a plan for the next one.';
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <header class="max-w-wide">
      <p class="text-steel text-caption tracking-wide uppercase">The loop</p>
      <h1 class="font-display text-h1 text-chalk tracking-display mt-4 text-balance">
        The whole driver improvement loop, in one place.
      </h1>
      <p class="text-steel text-body mt-6 max-w-prose">
        Four steps — capture, brain, plan, improve — that turn every session you run into a concrete
        plan for the next one.
      </p>
    </header>
  </main>
</BaseLayout>
