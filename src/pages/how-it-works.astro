---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowItWorksDiagram from '../components/HowItWorksDiagram.astro';
import HowItWorksCapture from '../components/HowItWorksCapture.astro';
import HowItWorksBrain from '../components/HowItWorksBrain.astro';
import HowItWorksPlan from '../components/HowItWorksPlan.astro';
import HowItWorksImprove from '../components/HowItWorksImprove.astro';
import HowItWorksHonesty from '../components/HowItWorksHonesty.astro';
import HowItWorksDevDocs from '../components/HowItWorksDevDocs.astro';
import FinalCta from '../components/FinalCta.astro';

// T042 set up the shell; T043 lands the real hero. H1 copy is locked
// by the sprint task and mirrors the doctrine's category framing
// ("loop"). The subhead previews the four sections T045-T048 will
// build out — capture, brain, plan, improve — which map one-to-one
// to ADR-005 objects (§5 capture schema / §5.2-§5.4 backend brain /
// next-session plan / §5.1 DriverProgressSnapshot). SEO retuning
// per targeted keyword lands in T054.

// T054 — SEO meta tuned for the long-tail keyword "sim racing
// coaching platform how it works". Title leads with the action
// ("How LAP works") and closes with the target noun phrase so a
// SERP snippet reads naturally rather than as keyword soup.
// Description leads with the target phrase and paraphrases the
// page's four-step scaffold to match the content below.
const TITLE = 'How LAP works — the sim racing coaching platform';
const DESCRIPTION =
  'The sim racing coaching platform that turns every sim and real-world session into a next-session plan. Capture, brain, plan, improve — four steps, one loop.';
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <header class="max-w-wide">
      <p class="text-steel text-caption tracking-wide uppercase">The loop</p>
      <h1 class="font-display text-h1 text-chalk tracking-display mt-4 text-balance">
        The whole driver improvement loop, in one place.
      </h1>
      <p class="text-steel text-body mt-6 max-w-prose">
        Four steps — capture, brain, plan, improve — that turn every session you run into a concrete
        plan for the next one.
      </p>
    </header>

    <div class="mt-16 sm:mt-20">
      <HowItWorksDiagram />
    </div>

    <HowItWorksCapture />
    <HowItWorksBrain />
    <HowItWorksPlan />
    <HowItWorksImprove />
    <HowItWorksHonesty />
    <HowItWorksDevDocs />
    <FinalCta />
  </main>
</BaseLayout>
