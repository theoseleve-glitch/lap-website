---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

// T023 locks the headline to Option B from 01-STRATEGIC-DOCTRINE.md §2.
// T024 locks the subhead below — the "ecosystem pitch" beat that
// stacks under the headline and delivers the doctrine's category claim
// ("Driver OS"), the cross-platform promise, and the progression echo.
// T025 locks the primary CTA: "Start 14-day trial" →
// https://app.lap-coach.racing/signup (cross-origin to the webapp).
// The secondary CTA href remains a placeholder refined in T026.
const HEADLINE = 'Every lap, one step better.';
const SUBHEAD =
  'The cross-platform Driver OS that turns every sim and real-world session into measurable progress.';
const PRIMARY_CTA = {
  text: 'Start 14-day trial',
  href: 'https://app.lap-coach.racing/signup',
};
const SECONDARY_CTA = {
  text: 'See how it works',
  href: '/how-it-works',
};
---

<BaseLayout title="LAP — Every lap, one step better.">
  <main>
    <Hero
      headline={HEADLINE}
      subhead={SUBHEAD}
      primaryCta={PRIMARY_CTA}
      secondaryCta={SECONDARY_CTA}
    />
  </main>
</BaseLayout>
