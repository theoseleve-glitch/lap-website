---
// src/pages/index.astro — Phase 3.2.
//
// Hero gate flow:
//   StartGrid       — 100vh entrance, headline + 5-light hold gate
//   HeroManifest    — subhead + CTAs (the [data-after-hero] anchor)
//   MarqueeStrip    — racing-keyword tape
//   Rooms 02–10     — narrative
//
// The press-and-hold release in FiveRedLights queries [data-after-hero]
// and smooth-scrolls to it, so HeroManifest is the next visual moment
// the user sees after the lights extinguish.
import BaseLayout from '../layouts/BaseLayout.astro';
import StartGrid from '../components/rooms/StartGrid.astro';
import HeroManifest from '../components/rooms/HeroManifest.astro';
import SessionProof from '../components/rooms/SessionProof.astro';
import S1Pain from '../components/rooms/S1Pain.astro';
import S2Versus from '../components/rooms/S2Versus.astro';
import S3Product from '../components/rooms/S3Product.astro';
import SimFirst from '../components/rooms/SimFirst.astro';
import PremiumLayer from '../components/rooms/PremiumLayer.astro';
import Garage from '../components/rooms/Garage.astro';
import PitStop from '../components/rooms/PitStop.astro';
import Podium from '../components/rooms/Podium.astro';
import MarqueeStrip from '../components/ui/MarqueeStrip.astro';
---

<BaseLayout title="LAP — Every lap, one step better.">
  <main>
    <StartGrid />
    <HeroManifest />
    <MarqueeStrip
      items={[
        'TELEMETRY',
        'LAP ANALYSIS',
        'CORNER COACHING',
        'PERFORMANCE SCORING',
        'SESSION DEBRIEF',
        'DATA ENGINEERING',
        'TRACK MAPPING',
      ]}
      speed={35}
    />
    <SessionProof />
    <S1Pain />
    <S2Versus />
    <S3Product />
    <SimFirst />
    <PremiumLayer />
    <Garage />
    <PitStop />
    <Podium />
  </main>
</BaseLayout>
