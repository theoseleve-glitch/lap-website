---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import DriverProfilePreview from '../components/DriverProfilePreview.astro';
import AfterEverySession from '../components/AfterEverySession.astro';
import SimAndReal from '../components/SimAndReal.astro';
import BuiltForSeriousSimRacers from '../components/BuiltForSeriousSimRacers.astro';
import ToolComparison from '../components/ToolComparison.astro';
import NotForYouIf from '../components/NotForYouIf.astro';
import FinalCta from '../components/FinalCta.astro';
import SocialProof from '../components/SocialProof.astro';

// Hero copy + CTAs locked by the T022-T026 staged sequence:
//   T023 — headline (Option B from 01-STRATEGIC-DOCTRINE.md §2)
//   T024 — subhead (ecosystem pitch: category + cross-platform + progression)
//   T025 — primary CTA → https://app.lap-coach.racing/signup
//   T026 — secondary CTA → /how-it-works (same-origin; route lands in T042)
// Every constant below is covered by Vitest + Playwright regression tests
// in src/__tests__/homepage.test.ts and tests/e2e/home.spec.ts.
const HEADLINE = 'Every lap, one step better.';
const SUBHEAD =
  'The cross-platform Driver OS that turns every sim and real-world session into measurable progress.';
const PRIMARY_CTA = {
  text: 'Start 14-day trial',
  href: 'https://app.lap-coach.racing/signup',
};
const SECONDARY_CTA = {
  text: 'See how it works',
  href: '/how-it-works',
};
---

<BaseLayout title="LAP — Every lap, one step better.">
  <main>
    <Hero
      headline={HEADLINE}
      subhead={SUBHEAD}
      primaryCta={PRIMARY_CTA}
      secondaryCta={SECONDARY_CTA}
    >
      <DriverProfilePreview slot="visual" />
    </Hero>
    <AfterEverySession />
    <SimAndReal />
    <BuiltForSeriousSimRacers />
    <ToolComparison />
    <NotForYouIf />
    <FinalCta />
    <SocialProof />
  </main>
</BaseLayout>
