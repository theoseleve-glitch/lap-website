---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

// T023 locks the headline to Option B from 01-STRATEGIC-DOCTRINE.md §2.
// See src/__tests__/homepage.test.ts for the rationale and a regression
// test that pins the exact string. The subhead, primary CTA href, and
// secondary CTA href below are placeholders refined in T024, T025, T026
// respectively — any edit there should keep the Hero contract intact.
const HEADLINE = 'Every lap, one step better.';
const SUBHEAD = 'The Driver OS for serious sim racers.';
const PRIMARY_CTA = {
  text: 'Start 14-day trial',
  href: 'https://app.lap-coach.racing/signup',
};
const SECONDARY_CTA = {
  text: 'See how it works',
  href: '/how-it-works',
};
---

<BaseLayout title="LAP — Every lap, one step better.">
  <main>
    <Hero
      headline={HEADLINE}
      subhead={SUBHEAD}
      primaryCta={PRIMARY_CTA}
      secondaryCta={SECONDARY_CTA}
    />
  </main>
</BaseLayout>
