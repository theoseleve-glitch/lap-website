---
import BaseLayout from '../layouts/BaseLayout.astro';

// T209 — public beta launch landing page. One-off, featured
// during launch week (week of 2026-07-23), stable as a
// permanent reference URL after.
//
// Today is Month 1 (2026-04-26); the launch is end Month 3.
// Copy is date-anchored — "LAP enters public beta on
// 2026-07-23" — so the page reads accurately whether the
// visitor lands ahead of the date (as a save-the-date) or
// after (as a historical anchor). On launch day, the founder
// can lightly tweak the leading verb ("LAP entered public
// beta on 2026-07-23") with no other content changes.
//
// Doctrine carry-over: §9 launch moments fix the dates,
// §8 fixes pricing (€15 consumer + €12 grandfathered
// founder rate + 14-day trial), §10 #4 fixes the no-LLM
// commitment that the differentiator paragraph names.
//
// Intentionally NOT featured on the homepage today — that
// swap happens at launch-week ops time (separate task).
// The page is reachable via direct URL and via the press
// release T208 references it from /launch.

const TITLE = 'Public beta launch — LAP';
const DESCRIPTION =
  'LAP enters public beta on 2026-07-23 — cross-platform driver development for sim and real-world racing, €15 per month, 14-day free trial, €12 grandfathered founder rate for the waitlist before launch.';

const HERO_HEADING_ID = 'launch-hero-heading';
const SHIPS_HEADING_ID = 'launch-ships-heading';
const NEXT_HEADING_ID = 'launch-next-heading';
const PRICING_HEADING_ID = 'launch-pricing-heading';
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <section aria-labelledby={HERO_HEADING_ID} class="max-w-prose">
      <p class="text-acid-green text-caption tracking-wide uppercase">
        Public beta · 2026-07-23
      </p>
      <h1
        id={HERO_HEADING_ID}
        class="font-display text-h1 text-chalk tracking-display mt-4 text-balance"
      >
        LAP enters public beta on 2026-07-23.
      </h1>
      <p class="text-steel text-body mt-6 leading-body">
        Cross-platform driver development for sim and real-world racing —
        every iRacing, Assetto Corsa Competizione, AMS2, and on-track
        session captured, diagnosed against a hand-curated rule library,
        and turned into a per-driver development plan with a named drill,
        a measurable success criterion, and a review cadence.
      </p>
      <p class="text-steel text-body mt-4 leading-body">
        The waitlist is open today. Members get the launch invite first
        and the grandfathered <strong class="text-chalk font-medium"
          >€12 per month for the first 12 months</strong
        > — €3 below the standard rate, durable across any future pricing
        change, and only available before public beta opens.
      </p>
      <p class="mt-8 flex flex-wrap gap-4">
        <a
          href="/waitlist"
          class="bg-acid-green text-asphalt rounded-2 hover:bg-acid-green/90 focus-visible:outline-chalk inline-block px-6 py-3 text-base font-medium tracking-wide transition"
        >
          Join the waitlist
        </a>
        <a
          href="/pricing"
          class="border-steel/40 text-chalk hover:border-chalk rounded-2 inline-block border px-6 py-3 text-base font-medium tracking-wide transition"
        >
          See pricing
        </a>
      </p>
    </section>

    <section
      aria-labelledby={SHIPS_HEADING_ID}
      class="border-steel/10 mt-24 max-w-prose border-t pt-16 sm:mt-32 sm:pt-20"
    >
      <p class="text-steel text-caption tracking-wide uppercase">
        On launch day
      </p>
      <h2
        id={SHIPS_HEADING_ID}
        class="font-display text-h2 text-chalk tracking-display mt-4 text-balance"
      >
        What ships in public beta.
      </h2>
      <ul class="text-steel text-body mt-8 flex flex-col gap-4 leading-body">
        <li>
          <strong class="text-chalk font-medium">Driver OS v1 on the web.</strong>
          Per-driver development plans, weakness episode rows, and the
          coaching library all live at lap-coach.racing.
        </li>
        <li>
          <strong class="text-chalk font-medium"
            >Sim ↔ real bridge MVP.</strong
          > Captures from iRacing, Assetto Corsa Competizione, and AMS2 share
          one driver record with on-track captures from a phone GPS or RaceBox.
          The same diagnoses, the same rule library, both surfaces.
        </li>
        <li>
          <strong class="text-chalk font-medium">Stripe billing live.</strong>
          €15 per month or €150 per year, 14-day free trial. Founder-rate
          grandfathering applied automatically to waitlist signups before
          launch day.
        </li>
        <li>
          <strong class="text-chalk font-medium"
            >Hand-curated coaching, in writing.</strong
          > Every prescription a driver sees traces to a rule the LAP team
          maintains in public — no language-model-generated coaching
          narrative anywhere in the surface.
        </li>
      </ul>
    </section>

    <section
      aria-labelledby={NEXT_HEADING_ID}
      class="border-steel/10 mt-24 max-w-prose border-t pt-16 sm:mt-32 sm:pt-20"
    >
      <p class="text-steel text-caption tracking-wide uppercase">
        After public beta
      </p>
      <h2
        id={NEXT_HEADING_ID}
        class="font-display text-h2 text-chalk tracking-display mt-4 text-balance"
      >
        V1 release on 2026-09-23.
      </h2>
      <p class="text-steel text-body mt-6 leading-body">
        Two months after public beta, the V1 release adds the Android
        application, the Apple Watch and WearOS companion for in-session
        prompts, the coaching library v1 with more than one hundred
        hand-curated rules, and explicit support for endurance events
        across multiple stints and driver swaps.
      </p>
      <p class="text-steel text-body mt-4 leading-body">
        The roadmap is published openly on the
        <a href="/blog" class="text-acid-green hover:underline">blog</a>.
        Monthly build-in-public updates land there with the deliberate
        omissions named alongside the work that shipped.
      </p>
    </section>

    <section
      aria-labelledby={PRICING_HEADING_ID}
      class="border-steel/10 mt-24 max-w-prose border-t pt-16 sm:mt-32 sm:pt-20"
    >
      <p class="text-steel text-caption tracking-wide uppercase">Pricing</p>
      <h2
        id={PRICING_HEADING_ID}
        class="font-display text-h2 text-chalk tracking-display mt-4 text-balance"
      >
        One tier. Founder rate ahead of launch.
      </h2>
      <p class="text-steel text-body mt-6 leading-body">
        After launch: <strong class="text-chalk font-medium"
          >€15 per month or €150 per year</strong
        >, with a 14-day free trial — no credit card asked at signup. Single
        consumer tier; no advertising-supported free tier and no plan to
        introduce one.
      </p>
      <p class="text-steel text-body mt-4 leading-body">
        Before launch (today): join the waitlist and the rate
        grandfathers to <strong class="text-chalk font-medium"
          >€12 per month for the first 12 months</strong
        > of paid use. The grandfathering survives any future pricing change.
      </p>
      <p class="text-steel text-body mt-4 leading-body">
        Racing schools and karting academies — multi-seat pricing
        starts from €10 per seat per month for programmes of ten or more
        drivers, finalised in conversation. Inbound conversation route:
        <a href="/for-schools" class="text-acid-green hover:underline"
          >/for-schools</a
        >.
      </p>
      <p class="mt-8">
        <a
          href="/waitlist"
          class="bg-acid-green text-asphalt rounded-2 hover:bg-acid-green/90 focus-visible:outline-chalk inline-block px-6 py-3 text-base font-medium tracking-wide transition"
        >
          Join the waitlist
        </a>
      </p>
    </section>

    <footer
      class="px-grid-margin text-steel/80 text-caption mx-auto mt-16 flex w-full max-w-6xl justify-center gap-6 pt-8 font-mono tracking-wide sm:mt-24"
    >
      <a
        href="/how-it-works"
        class="hover:text-chalk focus-visible:outline-chalk underline underline-offset-4 transition"
      >
        How it works
      </a>
      <a
        href="/pricing"
        class="hover:text-chalk focus-visible:outline-chalk underline underline-offset-4 transition"
      >
        Pricing
      </a>
      <a
        href="/blog"
        class="hover:text-chalk focus-visible:outline-chalk underline underline-offset-4 transition"
      >
        Blog
      </a>
    </footer>
  </main>
</BaseLayout>
