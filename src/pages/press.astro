---
import BaseLayout from '../layouts/BaseLayout.astro';

// T207 — /press kit page. The destination journalists,
// podcasters, and bloggers reach when they want the basic
// information about LAP without writing first to ask.
//
// T184 baseline: no paying customers, no public beta yet.
// Per doctrine §6 + §10 honesty discipline, anything that
// would be a fabrication ships as honest "lands here ahead
// of public beta" framing rather than synthesised content.
// Concretely:
//   - No fabricated press quotes / coverage logos.
//   - Founder profile defers until ahead of public beta;
//     organisation-level framing carries until then.
//   - Screenshots defer until public beta when the product
//     is live to photograph; T050/T051 are BLOCKED on real
//     screenshots upstream.
//
// Five labelled sections: facts, founder, logos, screenshots,
// contact. Footer links to /how-it-works + /pricing + /blog
// so a journalist scanning for depth has a path forward.

const TITLE = 'Press kit — LAP';
const DESCRIPTION =
  'LAP press kit for journalists and media — facts about the company, founder context, downloadable wordmark, screenshots policy, and the press contact email.';

const FACTS_HEADING_ID = 'press-facts-heading';
const FOUNDER_HEADING_ID = 'press-founder-heading';
const LOGOS_HEADING_ID = 'press-logos-heading';
const SCREENSHOTS_HEADING_ID = 'press-screenshots-heading';
const CONTACT_HEADING_ID = 'press-contact-heading';

const PRESS_MAILTO = 'mailto:sales@lap-coach.racing?subject=Press%20inquiry';

interface Fact {
  readonly key: string;
  readonly value: string;
}
const FACTS: ReadonlyArray<Fact> = [
  {
    key: 'Name',
    value: 'LAP — lap-coach.racing',
  },
  {
    key: 'Category',
    value:
      'Driver-development surface for sim and real-world racing. Cross-platform capture, hand-curated coaching rules, per-driver development plans.',
  },
  {
    key: 'Stage',
    value:
      'Pre-launch. Internal alpha at end of Month 1; closed private beta at end of Month 2; public beta at end of Month 3 (2026-07-23).',
  },
  {
    key: 'Pricing',
    value:
      'One membership: €19.90 per month standard, or €14.90 per month for the first 50 founding members. Includes a 30-day free trial with no card charged until it ends. Monthly only — no annual plan, no free tier, no B2B or multi-seat pricing. Cancel anytime. Charged in EUR.',
  },
  {
    key: 'Public beta launch',
    value:
      '2026-07-23. Stripe billing live, Driver OS v1, sim↔real bridge MVP, marketing site standalone.',
  },
  {
    key: 'V1 release',
    value:
      '2026-09-23. Android app, Apple Watch / WearOS companion, coaching library v1 (100+ rules), endurance events.',
  },
];
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <header class="max-w-prose">
      <p class="text-acid-green text-caption tracking-wide uppercase">Press</p>
      <h1 class="font-display text-h1 text-chalk tracking-display mt-4 text-balance">
        LAP press kit.
      </h1>
      <p class="text-steel text-body leading-body mt-6">
        Everything a journalist, podcaster, or blogger needs to write about LAP accurately — facts
        about the company, downloadable wordmark, the screenshots policy until public beta, and the
        press contact email.
      </p>
    </header>

    <section
      aria-labelledby={FACTS_HEADING_ID}
      class="border-steel/10 mt-24 max-w-prose border-t pt-16 sm:mt-32 sm:pt-20"
    >
      <p class="text-steel text-caption tracking-wide uppercase">Facts</p>
      <h2
        id={FACTS_HEADING_ID}
        class="font-display text-h2 text-chalk tracking-display mt-4 text-balance"
      >
        Quick facts.
      </h2>

      <dl class="mt-12 flex flex-col gap-8">
        {
          FACTS.map((fact) => (
            <div class="flex flex-col gap-2">
              <dt class="text-acid-green text-caption tracking-wide uppercase">{fact.key}</dt>
              <dd class="text-steel text-body leading-body">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section
      aria-labelledby={FOUNDER_HEADING_ID}
      class="border-steel/10 mt-24 max-w-prose border-t pt-16 sm:mt-32 sm:pt-20"
    >
      <p class="text-steel text-caption tracking-wide uppercase">Founder</p>
      <h2
        id={FOUNDER_HEADING_ID}
        class="font-display text-h2 text-chalk tracking-display mt-4 text-balance"
      >
        Built by a small founding team.
      </h2>
      <p class="text-steel text-body leading-body mt-6">
        LAP is in pre-launch development, built and operated by a small founding team with hands-on
        involvement in sim and real-world track sessions across the calendar year.
      </p>
      <p class="text-steel text-body leading-body mt-4">
        A named founder profile, photograph, and direct biographical text land on this page ahead of
        the public beta launch on 2026-07-23. Research enquiries before then can reach the founder
        directly at the press email below.
      </p>
    </section>

    <section
      aria-labelledby={LOGOS_HEADING_ID}
      class="border-steel/10 mt-24 max-w-prose border-t pt-16 sm:mt-32 sm:pt-20"
    >
      <p class="text-steel text-caption tracking-wide uppercase">Logos</p>
      <h2
        id={LOGOS_HEADING_ID}
        class="font-display text-h2 text-chalk tracking-display mt-4 text-balance"
      >
        LAP wordmark.
      </h2>
      <p class="text-steel text-body leading-body mt-6">
        SVG wordmark, dark text on transparent background — places cleanly on white article layouts.
        Right-click to save, or use the link below.
      </p>

      <div
        class="border-steel/15 rounded-2 bg-chalk mt-8 flex items-center justify-center border p-12"
      >
        <img src="/press/lap-wordmark.svg" alt="LAP wordmark" width="320" height="100" />
      </div>

      <p class="mt-6">
        <a href="/press/lap-wordmark.svg" download class="text-acid-green hover:underline">
          Download wordmark (SVG, transparent)
        </a>
      </p>
    </section>

    <section
      aria-labelledby={SCREENSHOTS_HEADING_ID}
      class="border-steel/10 mt-24 max-w-prose border-t pt-16 sm:mt-32 sm:pt-20"
    >
      <p class="text-steel text-caption tracking-wide uppercase">Screenshots</p>
      <h2
        id={SCREENSHOTS_HEADING_ID}
        class="font-display text-h2 text-chalk tracking-display mt-4 text-balance"
      >
        Screenshots ship at public beta.
      </h2>
      <p class="text-steel text-body leading-body mt-6">
        Application screenshots land on this page when the public beta goes live on 2026-07-23 —
        captured from the actual product running on real sessions, not synthesised mockups. Until
        then, the visual reference for what LAP looks like in the field is the OG imagery on the
        blog articles and the diagrammatic figures on
        <a href="/how-it-works" class="text-acid-green hover:underline">/how-it-works</a>.
      </p>
    </section>

    <section
      aria-labelledby={CONTACT_HEADING_ID}
      class="border-steel/10 mt-24 max-w-prose border-t pt-16 sm:mt-32 sm:pt-20"
    >
      <p class="text-steel text-caption tracking-wide uppercase">Contact</p>
      <h2
        id={CONTACT_HEADING_ID}
        class="font-display text-h2 text-chalk tracking-display mt-4 text-balance"
      >
        Press contact.
      </h2>
      <p class="text-steel text-body leading-body mt-6">
        Email
        <a href={PRESS_MAILTO} class="text-acid-green hover:underline">sales@lap-coach.racing</a> with
        subject "Press inquiry" and we will reply, usually within a working day. The same inbox routes
        sales, partnerships, and press; tag the subject so we triage cleanly.
      </p>
    </section>

    <footer
      class="px-grid-margin text-steel/80 text-caption mx-auto mt-16 flex w-full max-w-6xl justify-center gap-6 pt-8 font-mono tracking-wide sm:mt-24"
    >
      <a
        href="/how-it-works"
        class="hover:text-chalk focus-visible:outline-chalk underline underline-offset-4 transition"
      >
        How it works
      </a>
      <a
        href="/pricing"
        class="hover:text-chalk focus-visible:outline-chalk underline underline-offset-4 transition"
      >
        Pricing
      </a>
      <a
        href="/blog"
        class="hover:text-chalk focus-visible:outline-chalk underline underline-offset-4 transition"
      >
        Blog
      </a>
    </footer>
  </main>
</BaseLayout>
