---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingTierCard from '../components/PricingTierCard.astro';
import PricingIncluded from '../components/PricingIncluded.astro';
import PricingFounderOffer from '../components/PricingFounderOffer.astro';
import PricingFaq from '../components/PricingFaq.astro';
import PricingB2bTeaser from '../components/PricingB2bTeaser.astro';
import PricingValueAnchor from '../components/PricingValueAnchor.astro';

// T057 — shell for the /pricing page. The homepage T034 FinalCta
// (and its /how-it-works mirror via T052) links to /pricing via
// "See full pricing →"; shipping this shell means that link
// resolves to a real page instead of 404ing. T058 lands the tier
// card with €15/mo + €150/yr prices; T059 is the "what's included"
// checklist; T060 is the founder-waitlist offer; T061 the FAQ;
// T062 the B2B teaser; T063 wires the checkout CTA; T064 the
// value-anchor comparison vs human coaches; T065-T070 cover the
// refund link, contact sales, currency, perf, SEO, and e2e.

// T069 — SEO meta tuned for the long-tail keyword "sim racing
// coaching price". Title leads with the exact noun phrase so SERP
// snippets carry the match near the click. Description pairs the
// phrase with the concrete anchors (€15 / €150 / 14-day trial) so
// a visitor who clicked on the price query arrives with the answer
// already visible. Loop rule enforced: natural prose, not keyword
// soup.
const TITLE = 'Sim racing coaching price — LAP';
const DESCRIPTION =
  'One tier, clear price: €15 a month or €150 a year for sim racing coaching. 14-day full-feature trial, no card at signup. Cancel anytime.';
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <header class="max-w-prose">
      <p class="text-steel text-caption tracking-wide uppercase">Pricing</p>
      <h1 class="font-display text-h1 text-chalk tracking-display mt-4 text-balance">
        One tier. Clear price.
      </h1>
      <p class="text-steel text-body mt-6">
        A single monthly or yearly plan with a 14-day free trial. Cancel anytime from the dashboard.
      </p>
    </header>

    <PricingTierCard />
    <PricingIncluded />
    <PricingFounderOffer />
    <PricingFaq />
    <PricingB2bTeaser />
    <PricingValueAnchor />

    <footer
      class="px-grid-margin text-steel/80 text-caption mx-auto mt-16 flex w-full max-w-6xl justify-center gap-6 pt-8 font-mono tracking-wide sm:mt-24"
    >
      <a
        href="/refund-policy"
        class="hover:text-chalk focus-visible:outline-chalk underline underline-offset-4 transition"
      >
        Refund policy
      </a>
      <a
        href="mailto:sales@lap-coach.racing?subject=Sales%20inquiry"
        class="hover:text-chalk focus-visible:outline-chalk underline underline-offset-4 transition"
      >
        Contact sales
      </a>
    </footer>
  </main>
</BaseLayout>
