---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingCard from '../components/pricing/PricingCard.astro';
import MembershipFeatures from '../components/pricing/MembershipFeatures.astro';
import FoundingFifty from '../components/pricing/FoundingFifty.astro';
import FaqList from '../components/pricing/FaqList.astro';
import FoundingSpots from '../components/pricing/FoundingSpots.astro';
import GenerativeAtmosphere from '../components/cinematic/GenerativeAtmosphere.astro';
import BroadcastReveal from '../components/cinematic/BroadcastReveal.astro';
import { MEMBERSHIP, MEMBERSHIP_FAQ } from '../data/membership';
import { VALUE_ANCHOR } from '../data/marketing-copy';

const TITLE = 'Pricing — one LAP membership';
const DESCRIPTION =
  'One membership — €19.90/mo, €14.90/mo for the first 50 founding members, 30-day free trial.';

// Numeric forms for structured data — schema.org prices are bare decimals,
// no currency symbol. Derived from the canon so they can never drift.
const standardPrice = MEMBERSHIP.standardMonthly.replace(/[^\d.]/g, '');
const foundingPrice = MEMBERSHIP.foundingMonthly.replace(/[^\d.]/g, '');

// Genuine founding-50 scarcity, only when a real count is configured.
const foundingClaimed = Number(import.meta.env.PUBLIC_FOUNDING_CLAIMED);

// Product / AggregateOffer JSON-LD. Two offers (founding + standard) →
// lowPrice 14.90, highPrice 19.90, offerCount 2 — matches the webapp.
// No yearly card, no B2B, no free tier.
const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${MEMBERSHIP.name} Membership`,
  description:
    'A single membership unlocking the full LAP driver-development product: unlimited session analysis, race strategy, coaching plans, live monitoring, reports and logger auto-sync. 30-day free trial, monthly only.',
  brand: { '@type': 'Brand', name: 'LAP' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: foundingPrice,
    highPrice: standardPrice,
    offerCount: 2,
    offers: [
      {
        '@type': 'Offer',
        name: `Founding ${MEMBERSHIP.foundingLimit}`,
        price: foundingPrice,
        priceCurrency: 'EUR',
        description: `€${foundingPrice}/mo for the first ${MEMBERSHIP.foundingLimit} founding members, locked while the membership stays active.`,
        url: new URL(MEMBERSHIP.ctaHref, Astro.site ?? 'https://lap-coach.racing/').toString(),
      },
      {
        '@type': 'Offer',
        name: 'Standard membership',
        price: standardPrice,
        priceCurrency: 'EUR',
        description: `€${standardPrice}/mo standard membership with a ${MEMBERSHIP.trialDays}-day free trial.`,
        url: new URL(MEMBERSHIP.ctaHref, Astro.site ?? 'https://lap-coach.racing/').toString(),
      },
    ],
  },
};

// FAQPage JSON-LD mirrors the on-page FAQ so the answers are eligible for
// rich results and stay in lockstep with the rendered <FaqList />.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: MEMBERSHIP_FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <main>
    <!-- Hero — cinematic atmosphere + the single-membership card -->
    <section class="pricing-hero">
      <GenerativeAtmosphere seed={419} intensity="hero" />
      <div class="pricing-hero__inner px-grid-margin mx-auto max-w-6xl">
        <div class="prose-max">
          <p class="font-telemetry text-pit-orange">Pricing</p>
          <h1 class="font-monument text-h1 text-chalk mt-4 text-balance">
            One membership. One price.
          </h1>
          <p class="font-body text-body text-steel mt-6">
            No tiers, no add-ons, no free tier to outgrow. Everything LAP does is in one membership
            — {MEMBERSHIP.standardMonthly}/mo, or {MEMBERSHIP.foundingMonthly}/mo for the first {
              MEMBERSHIP.foundingLimit
            } founding members. Start with a
            {MEMBERSHIP.trialDays}-day free trial; no card is charged until it ends.
          </p>
          <p class="font-telemetry text-steel mt-5">{VALUE_ANCHOR}</p>
        </div>

        <div class="mt-12 flex flex-col items-center gap-5">
          <FoundingSpots claimed={foundingClaimed} />
          <PricingCard />
        </div>
      </div>
    </section>

    <!-- Everything in your membership -->
    <BroadcastReveal as="section" class="border-steel/10 border-t py-20 md:py-28">
      <div class="px-grid-margin mx-auto max-w-6xl">
        <h2 class="font-monument text-h3 text-chalk text-balance">Everything in your membership</h2>
        <p class="font-body text-body text-steel prose-max mt-4">
          Every member gets full access — nothing is held back behind a higher tier.
        </p>
        <div class="mt-10">
          <MembershipFeatures />
        </div>
      </div>
    </BroadcastReveal>

    <!-- Founding 50 callout -->
    <BroadcastReveal as="section" class="border-steel/10 border-t py-20 md:py-28">
      <div class="px-grid-margin mx-auto max-w-6xl">
        <FoundingFifty />
      </div>
    </BroadcastReveal>

    <!-- FAQ -->
    <BroadcastReveal as="section" class="border-steel/10 border-t py-20 md:py-28">
      <div class="px-grid-margin mx-auto max-w-6xl">
        <h2 class="font-monument text-h3 text-chalk text-balance">Frequently asked questions</h2>
        <div class="mt-10 max-w-3xl">
          <FaqList />
        </div>

        <p class="font-body text-caption text-steel mt-10">
          Cancel during the {MEMBERSHIP.trialDays}-day trial and you are never charged. For how
          refunds work after that, see our
          <a
            href="/refund-policy"
            class="text-chalk hover:text-pit-orange focus-visible:outline-pit-orange underline underline-offset-4 transition-colors"
          >
            refund policy</a
          >.
        </p>
      </div>
    </BroadcastReveal>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <script>
    // Funnel analytics — fire `pricing_viewed` on every /pricing page load.
    // Page-view event only (not motion); mirrors the welcome-page
    // waitlist_confirmed wiring.
    import { capturePricingViewed } from '../scripts/marketing-events';
    capturePricingViewed();
  </script>

  <style>
    .pricing-hero {
      position: relative;
      overflow: hidden;
      padding-block: clamp(4rem, 9vw, 7rem);
    }
    .pricing-hero__inner {
      position: relative;
      z-index: 1;
    }
  </style>
</BaseLayout>
