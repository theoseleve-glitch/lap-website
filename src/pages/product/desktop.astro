---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductPillarFooter from '../../components/ProductPillarFooter.astro';

// T108 — /product/desktop. The first per-pillar product page,
// covering the three sprint-spec areas: sim capture, live coaching,
// strategy. Sub-tasks layer onto this base:
//   * T109 — screenshots + video (BLOCKED until assets exist)
//   * T110 — download CTA → GitHub Releases (BLOCKED on T008 + a
//     released build)
//   * T111 — fuller supported-sims list
//   * T112 — system requirements
//
// "Live coaching" doctrine note: ADR-004 forbids LLM-driven
// coaching claims. The Live coaching section uses the sprint-spec
// vocabulary in the heading but the body frames it as rule-based
// reference signals (pace delta, sector deltas, optional in-cockpit
// overlay). No voice coach in your headset, no LLM. Same domain
// word, different mechanism.

const TITLE = 'LAP for desktop — sim capture, live coaching, strategy — LAP';
const DESCRIPTION =
  'LAP for desktop captures every sim session in real time, surfaces rule-based pace and sector reference signals while you drive, and ships race-night strategy tooling. iRacing, ACC, AMS2.';
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <header class="max-w-prose">
      <p class="text-acid-green text-caption tracking-wide uppercase">Desktop</p>
      <h1 class="font-display text-h1 text-chalk tracking-display mt-4 text-balance">
        LAP for desktop.
      </h1>
      <p class="text-steel text-body mt-6">
        The desktop client captures every sim session you drive, gives you live reference signals
        while you are still in the cockpit, and ships race-night strategy tooling for the events
        where the lap-by-lap data is the whole point.
      </p>
    </header>

    <div class="mt-16 flex flex-col gap-12">
      <section
        aria-labelledby="desktop-capture-heading"
        class="border-steel/15 max-w-prose border-t pt-10"
      >
        <p class="text-steel text-caption tracking-wide uppercase">Sim capture</p>
        <h2
          id="desktop-capture-heading"
          class="font-display text-h3 text-chalk tracking-display mt-3 text-balance"
        >
          Every session, in real time.
        </h2>
        <p class="text-steel text-body leading-body mt-4">
          Telemetry from <strong class="text-chalk font-medium">iRacing</strong>,
          <strong class="text-chalk font-medium">ACC</strong> (Assetto Corsa Competizione), and
          <strong class="text-chalk font-medium">AMS2</strong> (Automobilista 2) streams into LAP automatically.
          No file imports, no post-session paste. The session lands in your driver profile the moment
          you exit the cockpit, with weaknesses already flagged for the next drill cycle.
        </p>
      </section>

      <section
        aria-labelledby="desktop-coaching-heading"
        class="border-steel/15 max-w-prose border-t pt-10"
      >
        <p class="text-steel text-caption tracking-wide uppercase">Live coaching</p>
        <h2
          id="desktop-coaching-heading"
          class="font-display text-h3 text-chalk tracking-display mt-3 text-balance"
        >
          Rule-based reference, not a voice in your headset.
        </h2>
        <p class="text-steel text-body leading-body mt-4">
          Live coaching here means signals you read at your own pace: lap-time delta against your
          personal best on this track plus car combo, sector deltas against your reference lap, and
          an optional in-cockpit overlay for the brake and throttle traces of the reference lap. The
          signals come from the rule library and the data from your own driving — no generated
          commentary, no chat-box trying to talk to you while you are at the wheel.
        </p>
      </section>

      <section
        aria-labelledby="desktop-strategy-heading"
        class="border-steel/15 max-w-prose border-t pt-10"
      >
        <p class="text-steel text-caption tracking-wide uppercase">Strategy</p>
        <h2
          id="desktop-strategy-heading"
          class="font-display text-h3 text-chalk tracking-display mt-3 text-balance"
        >
          Race-night tooling.
        </h2>
        <p class="text-steel text-body leading-body mt-4">
          Endurance events and serious races run on the lap-by-lap numbers — pace targets, fuel
          stints, tyre management, the gap to the car ahead three corners from now. The strategy
          surface puts those numbers next to your live session so the call you make in lap 47 is the
          call the data already supports, not the call the spotter remembered.
        </p>
      </section>

      <section
        aria-labelledby="desktop-supported-sims-heading"
        class="border-steel/15 border-t pt-10"
      >
        <p class="text-steel text-caption tracking-wide uppercase">Supported sims</p>
        <h2
          id="desktop-supported-sims-heading"
          class="font-display text-h3 text-chalk tracking-display mt-3 text-balance"
        >
          The sims LAP captures from today.
        </h2>
        <ul class="mt-6 grid gap-6 sm:grid-cols-3">
          <li class="border-steel/15 bg-concrete/20 rounded-2 border p-6">
            <p class="text-chalk text-body font-medium">iRacing</p>
            <p class="text-steel text-body leading-body mt-3 text-sm">
              Official series, ranked multiplayer, the leagues serious sim racers run their seasons
              in. Telemetry via the iRacing SDK; an active subscription is required.
            </p>
          </li>
          <li class="border-steel/15 bg-concrete/20 rounded-2 border p-6">
            <p class="text-chalk text-body font-medium">Assetto Corsa Competizione</p>
            <p class="text-steel text-body leading-body mt-3 text-sm">
              GT3 and GT4 racing, endurance formats, the Blancpain-derived car set. Shared-memory
              telemetry; one-time purchase, no subscription.
            </p>
          </li>
          <li class="border-steel/15 bg-concrete/20 rounded-2 border p-6">
            <p class="text-chalk text-body font-medium">Automobilista 2</p>
            <p class="text-steel text-body leading-body mt-3 text-sm">
              Formula, stock cars, prototypes, and a broad track list including the Brazilian
              circuits. Shared-memory telemetry; one-time purchase, expansions sold separately.
            </p>
          </li>
        </ul>
      </section>

      <section
        aria-labelledby="desktop-system-requirements-heading"
        class="border-steel/15 max-w-prose border-t pt-10"
      >
        <p class="text-steel text-caption tracking-wide uppercase">System requirements</p>
        <h2
          id="desktop-system-requirements-heading"
          class="font-display text-h3 text-chalk tracking-display mt-3 text-balance"
        >
          What you need on your rig.
        </h2>
        <ul class="text-steel text-body leading-body mt-6 ml-6 list-disc space-y-3">
          <li>
            <strong class="text-chalk font-medium"
              >Windows 10 (build 1809 or newer) or Windows 11, 64-bit.</strong
            >
            Sims live on Windows, so the desktop client does too.
          </li>
          <li>
            About <strong class="text-chalk font-medium">200 MB of disk</strong> for the installer and
            the local cache, plus
            <strong class="text-chalk font-medium">200&ndash;300 MB of RAM</strong> on top of what the
            sim already uses. The capture path is a thin overlay; it does not steal frames from your sim.
          </li>
          <li>
            <strong class="text-chalk font-medium">An internet connection</strong> for first sign-in and
            for cloud sync of your driver profile. Capture itself works offline; the session uploads on
            the next reconnect, so a flaky home network does not lose data.
          </li>
        </ul>
        <p class="text-steel text-body leading-body mt-6">
          <strong class="text-chalk font-medium">macOS</strong> support is on the roadmap but not shipped.
          If you race exclusively on a Mac today, LAP is not for you yet — we would rather say so than
          have you waste a trial.
        </p>
      </section>
    </div>

    <ProductPillarFooter currentSlug="desktop" />
  </main>
</BaseLayout>
