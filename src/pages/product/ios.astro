---
import BaseLayout from '../../layouts/BaseLayout.astro';

// T130 — /product/ios coming-soon page. Closes Block G of the
// marketing sprint.
//
// Why a dedicated page when /product/mobile already discloses the
// iOS-not-yet posture: the dedicated URL is the inbound-search
// landing surface. Someone Googling "LAP iOS app" or "racing
// iPhone app" should land here, not on /product/mobile where the
// disclosure is buried four sections in.
//
// Doctrine §9 timing — iOS lands at V1 release (M5 / 2026-09-23),
// not at public beta (M3 / 2026-07-23). Same anchor /product/mobile
// uses; this page makes it the headline.
//
// The page is INDEXABLE (no noindex). When iOS ships at V1, this
// page either becomes the actual iOS pillar page or 301-redirects
// to it; until then the indexable coming-soon surface is the
// right answer for inbound iOS-search traffic.

const TITLE = 'LAP for iPhone — coming with V1, September 2026';
const DESCRIPTION =
  'LAP for iPhone is on the roadmap and lands with the V1 release in September 2026 — after the Android public beta. Join the waitlist to get notified when the iOS app ships.';
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <header class="max-w-prose">
      <p class="text-acid-green text-caption tracking-wide uppercase">iOS</p>
      <h1 class="font-display text-h1 text-chalk tracking-display mt-4 text-balance">
        LAP for iPhone — coming with V1.
      </h1>
      <p class="text-steel text-body mt-6">
        LAP for iOS is on the roadmap and lands at the V1 release in September 2026 — not at public
        beta. If you race exclusively on an iPhone today, the waitlist is the right place to wait.
        We will email you when the iOS app ships, not before.
      </p>

      <p class="mt-8">
        <a
          href="/waitlist"
          class="bg-acid-green text-asphalt hover:bg-acid-green/90 text-body inline-flex items-center gap-2 rounded-md px-5 py-3 font-medium transition"
        >
          Join the waitlist
        </a>
      </p>
    </header>

    <div class="mt-16 flex flex-col gap-12">
      <section
        aria-labelledby="ios-when-heading"
        class="border-steel/15 max-w-prose border-t pt-10"
      >
        <p class="text-steel text-caption tracking-wide uppercase">When iOS arrives</p>
        <h2
          id="ios-when-heading"
          class="font-display text-h3 text-chalk tracking-display mt-3 text-balance"
        >
          September 2026, with the V1 release.
        </h2>
        <p class="text-steel text-body leading-body mt-4">
          Public beta opens in July 2026 on Android. iOS does not arrive at the same time, and that
          is deliberate. We are running the public beta as a single-platform release — Android first
          — so the team can move fast on the things drivers actually use the mobile app for
          (real-world capture, RaceBox pairing, sync to the driver profile) instead of splitting
          attention across two app stores from day one. The iPhone build follows two months later,
          at the V1 release on 2026-09-23.
        </p>
        <p class="text-steel text-body leading-body mt-4">
          Founder pricing, applied to the waitlist date — sign up before public beta and the founder
          rate carries through to the iOS launch. Joining the waitlist now does not require you to
          test the Android app; it just secures your spot in the queue and the price.
        </p>
      </section>

      <section
        aria-labelledby="ios-shape-heading"
        class="border-steel/15 max-w-prose border-t pt-10"
      >
        <p class="text-steel text-caption tracking-wide uppercase">What it will look like</p>
        <h2
          id="ios-shape-heading"
          class="font-display text-h3 text-chalk tracking-display mt-3 text-balance"
        >
          The same shape as the Android app.
        </h2>
        <p class="text-steel text-body leading-body mt-4">
          The iOS build is not a redesign — it is the same product as the Android app on a different
          platform. Phone GPS for the entry-level capture, bluetooth GNSS receivers (RaceBox or
          compatible) for high-fidelity sector data, sync to the same driver profile shared with
          your sim sessions on desktop. The shipping Android app is the right preview of what the
          iOS surface will look like in September.
        </p>
        <p class="text-steel text-body leading-body mt-4">
          See the
          <a
            href="/product/mobile"
            class="text-chalk hover:text-acid-green underline underline-offset-4 transition"
            >mobile pillar page</a
          > for the full feature set the iOS build inherits — RaceBox integration, Wear OS-equivalent
          companion (Apple Watch when iOS lands), the lot.
        </p>
      </section>

      <section aria-labelledby="ios-now-heading" class="border-steel/15 max-w-prose border-t pt-10">
        <p class="text-steel text-caption tracking-wide uppercase">What you can do today</p>
        <h2
          id="ios-now-heading"
          class="font-display text-h3 text-chalk tracking-display mt-3 text-balance"
        >
          Two paths, both honest.
        </h2>
        <p class="text-steel text-body leading-body mt-4">
          <strong class="text-chalk font-medium">If you have an Android device handy</strong> — even a
          spare or a partner's — you can join public beta in July 2026 and capture real-world track days
          through the Android app while you wait for the iPhone build. Your driver profile will keep the
          data and your iOS app will pick up where the Android one left off.
        </p>
        <p class="text-steel text-body leading-body mt-4">
          <strong class="text-chalk font-medium">If you race exclusively on iPhone</strong>, the
          waitlist email gets you the iOS launch announcement first, and the founder rate locks at
          the date you sign up. You do not have to do anything between now and September except stay
          on the list.
        </p>
      </section>
    </div>

    <p class="mt-16">
      <a
        href="/product"
        class="text-chalk hover:text-acid-green text-body inline-flex items-center underline underline-offset-4 transition"
      >
        ← Back to product overview
      </a>
    </p>
  </main>
</BaseLayout>
