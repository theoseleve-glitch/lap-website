---
import BaseLayout from '../layouts/BaseLayout.astro';

// T065 — refund policy. Doctrine-aligned: the 14-day full-feature
// free trial (01-STRATEGIC-DOCTRINE.md §8) is the practical refund
// policy for most users; this page covers what happens after the
// trial + statutory EU rights + the grandfathered-rate durability
// (§10 bullet 5). No overclaim ("always refund") and no user-hostile
// absolutes ("no refunds ever") — a reachable contact closes the gap.

const TITLE = 'Refund policy — LAP';
const DESCRIPTION =
  'The 14-day free trial handles most refund cases. After the trial, cancel anytime from the dashboard; incorrect charges get investigated by email.';
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <main class="px-grid-margin mx-auto w-full max-w-3xl py-24 sm:py-32">
    <header class="max-w-prose">
      <p class="text-steel text-caption tracking-wide uppercase">Policy</p>
      <h1 class="font-display text-h1 text-chalk tracking-display mt-4 text-balance">
        Refund policy.
      </h1>
      <p class="text-steel text-body mt-6">
        The 14-day full-feature free trial is how we handle refunds by default. If you decide LAP
        isn&rsquo;t for you, cancel during the trial and nothing is charged. This page covers what
        happens after.
      </p>
    </header>

    <div class="text-steel text-body leading-body mt-12 flex flex-col gap-10">
      <section aria-labelledby="refund-trial-heading">
        <h2
          id="refund-trial-heading"
          class="font-display text-h3 text-chalk tracking-display text-balance"
        >
          Trial
        </h2>
        <p class="mt-4">
          The 14-day trial needs only your email. No credit card is stored, no subscription starts.
          If you cancel during the trial, nothing is charged and you owe nothing.
        </p>
      </section>

      <section aria-labelledby="refund-cancel-heading">
        <h2
          id="refund-cancel-heading"
          class="font-display text-h3 text-chalk tracking-display text-balance"
        >
          Cancellation
        </h2>
        <p class="mt-4">
          Cancel a paid plan anytime from the dashboard. The plan runs until the end of the current
          billing period — monthly plans run to the end of the month, yearly plans run to the end of
          the paid year. Your data remains exportable for 30 days after the plan ends.
        </p>
      </section>

      <section aria-labelledby="refund-paid-heading">
        <h2
          id="refund-paid-heading"
          class="font-display text-h3 text-chalk tracking-display text-balance"
        >
          Refunds on paid periods
        </h2>
        <p class="mt-4">
          Paid months and years that have started are not automatically refunded. If you were
          incorrectly charged — double-billing, a plan you did not authorise, a technical failure
          preventing you from using the product — email
          <a
            href="mailto:support@lap-coach.racing"
            class="text-chalk hover:text-acid-green underline underline-offset-4 transition"
          >
            support@lap-coach.racing
          </a>
          and we will investigate. We do not auto-deny refund requests.
        </p>
      </section>

      <section aria-labelledby="refund-regulatory-heading">
        <h2
          id="refund-regulatory-heading"
          class="font-display text-h3 text-chalk tracking-display text-balance"
        >
          EU statutory rights
        </h2>
        <p class="mt-4">
          EU consumers retain their statutory 14-day right of withdrawal for distance-sold digital
          services. The trial period satisfies this right by default. To invoke withdrawal after a
          paid charge, email
          <a
            href="mailto:support@lap-coach.racing"
            class="text-chalk hover:text-acid-green underline underline-offset-4 transition"
          >
            support@lap-coach.racing
          </a>
          within 14 days of the first paid charge.
        </p>
      </section>

      <section aria-labelledby="refund-grandfathered-heading">
        <h2
          id="refund-grandfathered-heading"
          class="font-display text-h3 text-chalk tracking-display text-balance"
        >
          Grandfathered waitlist
        </h2>
        <p class="mt-4">
          Waitlist members on the grandfathered €12 / month rate keep those terms for 12 months from
          the first paid month, regardless of any policy or pricing change.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>
