---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import WaitlistCount from '../components/WaitlistCount.astro';
import { MEMBERSHIP } from '../data/membership';

// T091 — /waitlist route. Mounts the WaitlistForm so the route
// referenced by T060 PricingFounderOffer ("Signed up before
// launch? €12 a month for 12 months") resolves to a real page
// where a visitor can actually become a founder. Block F's
// later tasks (T092 Worker, T093 Turnstile, T094 double-opt-in,
// T095 welcome page, T096-T099 drip emails) layer onto the form
// without changing this page's surface.

// T088-style SEO: the title leads with the action ("Join the
// LAP waitlist") + a price anchor in the description. No keyword
// soup — these are the words a visitor in the founder-rate window
// would search for, used because they describe the page.
const TITLE = 'Join the LAP waitlist — LAP';
const DESCRIPTION = `Join the LAP waitlist for the public beta launch. Launch invite first, plus a head start to claim a founding spot at ${MEMBERSHIP.foundingMonthly}/mo — €5 under the ${MEMBERSHIP.standardMonthly} standard, with a ${MEMBERSHIP.trialDays}-day free trial. Email-only, GDPR-compliant.`;

// T102 — public waitlist count, optional. Read from build-time
// env so the founder can publish the number once it crosses 100
// without code changes (set PUBLIC_WAITLIST_COUNT=247 in
// Cloudflare Pages env, redeploy). Below 100 the component
// renders nothing; the page reads identically to the pre-T102
// state, so the existing /waitlist tests remain untouched.
const rawCount = import.meta.env.PUBLIC_WAITLIST_COUNT;
const waitlistCount = Number.parseInt(rawCount ?? '0', 10);
---

<BaseLayout title={TITLE} description={DESCRIPTION}>
  <main class="px-grid-margin mx-auto w-full max-w-6xl py-24 sm:py-32">
    <header class="max-w-prose">
      <p class="text-steel text-caption tracking-wide uppercase">Waitlist</p>
      <h1 class="font-display text-h1 text-chalk tracking-display mt-4 text-balance">
        Join the LAP waitlist.
      </h1>
      <p class="text-steel text-body mt-6">
        LAP opens public beta soon. Waitlist members get the launch invite first, plus a head start
        to claim one of the {MEMBERSHIP.foundingLimit} founding spots —
        <strong class="text-chalk font-medium">{MEMBERSHIP.foundingMonthly} a month</strong>, €5
        under the {MEMBERSHIP.standardMonthly} standard rate, with a {MEMBERSHIP.trialDays}-day free
        trial.
      </p>
    </header>

    <div class="mt-8">
      <WaitlistCount count={waitlistCount} />
    </div>

    <WaitlistForm />
  </main>
</BaseLayout>

<script>
  // T103 — side-effect import auto-fires `waitlist_submitted` if
  // the URL is /waitlist?status=submitted (the form-POST 303
  // destination). On a normal first GET there are no params, so
  // nothing fires.
  import '../scripts/waitlist-events';
</script>
